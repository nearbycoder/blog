<div class="relative" data-theme-root>
  <button type="button" class="btn btn-ghost h-11 w-11 p-0" aria-haspopup="true" aria-expanded="false" data-theme-trigger aria-label="Choose color theme">
    <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.7">
      <circle cx="12" cy="12" r="7"></circle><path d="M12 5a7 7 0 0 1 0 14Z" fill="currentColor"></path>
    </svg>
  </button>
  <div class="absolute right-0 z-40 mt-2 hidden w-48 border p-1" style="border-color: var(--border); background: var(--surface);" role="menu" data-theme-menu>
    <button type="button" class="flex w-full items-center justify-between px-3 py-2.5 label-strong" data-theme-option="light" role="menuitem"><span>Light</span><span class="label">L</span></button>
    <button type="button" class="flex w-full items-center justify-between px-3 py-2.5 label-strong" data-theme-option="dark" role="menuitem"><span>Dark</span><span class="label">D</span></button>
    <button type="button" class="flex w-full items-center justify-between px-3 py-2.5 label-strong" data-theme-option="system" role="menuitem"><span>System</span><span class="label">OS</span></button>
  </div>
  <script is:inline>
    (() => {
      const root = document.documentElement;
      const storageKey = "theme-preference";
      const container = document.currentScript?.closest("[data-theme-root]");
      if (!container) return;
      const trigger = container.querySelector("[data-theme-trigger]");
      const menu = container.querySelector("[data-theme-menu]");
      const options = Array.from(container.querySelectorAll("[data-theme-option]"));
      const close = () => { menu?.classList.add("hidden"); trigger?.setAttribute("aria-expanded", "false"); };
      const update = () => options.forEach((button) => {
        const active = button.getAttribute("data-theme-option") === (root.getAttribute("data-theme") || "system");
        button.style.background = active ? "var(--accent)" : "";
        button.style.color = active ? "var(--accent-fg)" : "";
        button.setAttribute("aria-pressed", String(active));
      });
      trigger?.addEventListener("click", (event) => {
        event.stopPropagation();
        const hidden = menu?.classList.contains("hidden");
        menu?.classList.toggle("hidden", !hidden);
        trigger.setAttribute("aria-expanded", String(hidden));
      });
      options.forEach((button) => button.addEventListener("click", () => {
        const value = button.getAttribute("data-theme-option") || "system";
        root.setAttribute("data-theme", value);
        try { localStorage.setItem(storageKey, value); } catch {}
        update(); close();
      }));
      document.addEventListener("click", (event) => { if (!container.contains(event.target)) close(); });
      document.addEventListener("keydown", (event) => { if (event.key === "Escape") close(); });
      update();
    })();
  </script>
</div>
