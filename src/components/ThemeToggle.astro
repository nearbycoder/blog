---
import Icon from "./Icon.astro";
---

<div class="relative" data-theme-root>
  <button
    type="button"
    class="btn btn-ghost icon-button"
    aria-expanded="false"
    aria-controls="theme-options"
    data-theme-trigger
    aria-label="Choose color theme"><Icon name="theme" /></button
  >
  <div
    id="theme-options"
    class="absolute right-0 z-40 mt-2 w-44 rounded-lg border p-1"
    style="border-color:var(--border);background:var(--surface);box-shadow:0 10px 35px #0002"
    data-theme-menu
    hidden
  >
    <div role="group" aria-label="Color theme">
      {
        ["light", "dark", "system"].map((theme) => (
          <button
            type="button"
            class="flex w-full rounded px-3 py-3 text-sm"
            data-theme-option={theme}
            aria-pressed="false"
          >
            {theme[0].toUpperCase() + theme.slice(1)}
          </button>
        ))
      }
    </div>
  </div>
</div>
<script>
  const container = document.querySelector<HTMLElement>("[data-theme-root]")!;
  const trigger = container.querySelector<HTMLButtonElement>(
    "[data-theme-trigger]",
  )!;
  const menu = container.querySelector<HTMLElement>("[data-theme-menu]")!;
  const options = Array.from(
    container.querySelectorAll<HTMLButtonElement>("[data-theme-option]"),
  );
  const close = () => {
    menu.hidden = true;
    trigger.setAttribute("aria-expanded", "false");
  };
  const update = () =>
    options.forEach((button) => {
      const active =
        button.dataset.themeOption ===
        (document.documentElement.dataset.theme || "system");
      button.style.background = active ? "var(--accent-soft)" : "";
      button.style.color = active ? "var(--accent)" : "";
      button.setAttribute("aria-pressed", String(active));
    });
  trigger.addEventListener("click", () => {
    menu.hidden = !menu.hidden;
    trigger.setAttribute("aria-expanded", String(!menu.hidden));
    if (!menu.hidden)
      options.find((b) => b.getAttribute("aria-pressed") === "true")?.focus();
  });
  options.forEach((button) =>
    button.addEventListener("click", () => {
      const value = button.dataset.themeOption!;
      document.documentElement.dataset.theme = value;
      try {
        localStorage.setItem("theme-preference", value);
      } catch {}
      update();
      close();
      trigger.focus();
    }),
  );
  document.addEventListener("click", (event) => {
    if (!container.contains(event.target as Node)) close();
  });
  container.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      close();
      trigger.focus();
    }
    if (event.key === "ArrowDown" || event.key === "ArrowUp") {
      event.preventDefault();
      const index = options.indexOf(
        document.activeElement as HTMLButtonElement,
      );
      options[
        (index + (event.key === "ArrowDown" ? 1 : options.length - 1)) %
          options.length
      ].focus();
    }
  });
  document.addEventListener("themechange", update);
  update();
</script>
