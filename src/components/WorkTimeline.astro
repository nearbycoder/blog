---
import { site } from "../data/site";
---

<ol class="window-panel">
  {(site.work as any[]).map((item: { company: string; role: string; range: string }, index: number) => (
    <li
      class="grid gap-3 px-5 py-4 sm:grid-cols-[auto_1fr_auto] sm:items-center sm:gap-6 sm:px-6"
      style={index === 0 ? undefined : "border-top: 1.5px dashed var(--border);"}
    >
      <span class="card-index">
        {String(index + 1).padStart(2, "0")}
      </span>
      <div class="min-w-0">
        <p class="display text-2xl sm:text-3xl" style="line-height: 1;">{item.company}</p>
        <p class="font-mono text-xs font-bold uppercase tracking-normal" style="color: var(--fg-muted);">{item.role}</p>
      </div>
      <span class="font-mono text-xs font-bold uppercase tracking-normal sm:justify-self-end" style="color: var(--fg-muted);">
        {item.range}
      </span>
    </li>
  ))}
</ol>
