---
import { site } from "../data/site";

const accentMap: Record<string, string> = {
  amber: "from-amber-500/20 via-transparent",
  cyan: "from-cyan-400/20 via-transparent",
  rose: "from-rose-400/20 via-transparent",
  mist: "from-white/10 via-transparent",
};
---

<div class="relative space-y-5 pt-2">
  {(site.work as any[]).map((item: { company: string; role: string; range: string; accent: string }) => (
    <div class="relative grid gap-4 md:grid-cols-[8.5rem_minmax(0,1fr)] md:items-center md:gap-6">
      <div class="relative z-10 flex items-center gap-3 pr-2 text-xs uppercase tracking-[0.2em] text-[color:var(--fog-500)] whitespace-nowrap">
        <span class="h-3 w-3 shrink-0 rounded-full border border-white/20 bg-white/10"></span>
        <span>{item.range}</span>
      </div>
      <div class="card glass min-w-0 rounded-2xl px-5 py-4 overflow-hidden relative">
        <div class={`absolute inset-0 bg-gradient-to-br ${accentMap[item.accent] ?? accentMap.mist} to-transparent opacity-60`}></div>
        <p class="text-base font-semibold text-white relative z-10">{item.company}</p>
        <p class="text-sm text-[color:var(--mist-200)] relative z-10">{item.role}</p>
      </div>
    </div>
  ))}
</div>
