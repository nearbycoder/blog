---
import { site } from "../data/site";
---

<ol class="block-box block-box-shadow">
  {(site.work as any[]).map((item: { company: string; role: string; range: string }, index: number) => (
    <li
      class="grid grid-cols-[auto_1fr_auto] items-center gap-4 px-5 py-4 sm:gap-6 sm:px-6"
      style={index === 0 ? undefined : "border-top: 2px solid var(--border);"}
    >
      <span class="font-mono text-xs font-bold uppercase tracking-[0.1em] text-right" style="color: var(--fg-dim); min-width: 5rem;">
        {String(index + 1).padStart(2, "0")} /
      </span>
      <div class="min-w-0">
        <p class="display text-lg sm:text-xl" style="line-height: 1.1;">{item.company}</p>
        <p class="font-mono text-xs uppercase tracking-[0.12em]" style="color: var(--fg-muted);">{item.role}</p>
      </div>
      <span class="font-mono text-xs uppercase tracking-[0.12em] whitespace-nowrap" style="color: var(--fg-muted);">
        {item.range}
      </span>
    </li>
  ))}
</ol>
