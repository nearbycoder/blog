---
import { site } from "../data/site";
const total = site.work.length;
---

<div class="tower">
  <div class="tower-crown" aria-hidden="true">
    <span class="tower-beacon"></span>
    <span class="tower-status">Currently shipping</span>
  </div>
  <ol class="timeline" reversed>
    {
      site.work.map((item, index) => (
        <li style={`--setback:${Math.max(0, 4 - index)}`}>
          <span class="floor-tag" aria-hidden="true">
            {String(total - index).padStart(2, "0")}
          </span>
          <span class="label">{item.range}</span>
          <h3>{item.company}</h3>
          <p>{item.role}</p>
        </li>
      ))
    }
  </ol>
  <div class="tower-base" aria-hidden="true">
    <span>Archive origin · 2013</span>
  </div>
</div>
