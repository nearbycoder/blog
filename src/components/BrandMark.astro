---
// Nearby Atelier: folded refractive obsidian-glass prism with a molten chartreuse spark.
const { class: className = "brand-mark" } = Astro.props;
---

<svg viewBox="0 0 32 32" class={className} aria-hidden="true">
  <defs>
    <linearGradient id="atelier-facet-a" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="currentColor" stop-opacity="0.92"></stop>
      <stop offset="100%" stop-color="currentColor" stop-opacity="0.22"></stop>
    </linearGradient>
    <linearGradient id="atelier-facet-b" x1="100%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.95"></stop>
      <stop offset="60%" stop-color="var(--opal)" stop-opacity="0.55"></stop>
      <stop offset="100%" stop-color="currentColor" stop-opacity="0.12"></stop>
    </linearGradient>
  </defs>
  <rect
    class="brand-frame"
    x="2.5"
    y="2.5"
    width="27"
    height="27"
    rx="8"
    fill="none"
    stroke="currentColor"
    stroke-opacity="0.24"
    stroke-width="1.2"></rect>
  <path
    class="brand-ribbon-back"
    d="M9.5 23.5V9.2c0-.7.8-1 1.3-.5l11.4 12.6c.5.5 1.3.2 1.3-.5V8.5"
    fill="none"
    stroke="url(#atelier-facet-a)"
    stroke-width="2.2"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
  <path
    class="brand-ribbon-front"
    d="M9.5 23.5C13.5 19.2 18.5 12.8 22.5 8.5"
    fill="none"
    stroke="url(#atelier-facet-b)"
    stroke-width="2.2"
    stroke-linecap="round"></path>
  <circle class="brand-spark" cx="22.5" cy="8.5" r="2.2"></circle>
</svg>
