---
import { resolveArticleAccent } from "../lib/articles";
import { renderCardArtSvg } from "../lib/card-art";

const entry = Astro.props.entry as any;
const index = (Astro.props.index as number | undefined) ?? 0;
const number = String(index + 1).padStart(2, "0");
const svgMarkup = renderCardArtSvg({
  slug: entry.id,
  tags: entry.data.tags ?? [],
  accent: resolveArticleAccent(entry),
});
---

<a
  href={`/articles/${entry.id}`}
  class="block-box block-box-shadow block-box-hover group flex h-full flex-col overflow-hidden"
>
  <div class="relative aspect-[16/10] overflow-hidden rule-b" style="border-color: var(--border); background: var(--surface-2);">
    <div class="absolute inset-0" set:html={svgMarkup}></div>
    <span class="card-index absolute left-3 top-3">
      {number}
    </span>
    <span class="chip absolute bottom-3 right-3">
      Essay
    </span>
  </div>
  <div class="flex flex-1 flex-col gap-4 p-5 md:p-6">
    <div class="meta-row justify-between gap-3 text-[0.68rem]">
      <span>{entry.data.date}</span>
      {entry.data.readTime ? <span>{entry.data.readTime}</span> : null}
    </div>
    <div class="space-y-2">
      <h3 class="display text-2xl leading-[1] transition group-hover:underline md:text-3xl" style="text-decoration-color: var(--accent); text-decoration-thickness: 3px; text-underline-offset: 4px;">
        {entry.data.title}
      </h3>
      <p class="text-sm leading-relaxed" style="color: var(--fg-muted);">{entry.data.description}</p>
    </div>
    {entry.data.tags && entry.data.tags.length ? (
      <div class="mt-auto flex flex-wrap gap-1.5 pt-2">
        {entry.data.tags.map((tag: string) => (
          <span class="chip">{tag}</span>
        ))}
      </div>
    ) : null}
  </div>
</a>
