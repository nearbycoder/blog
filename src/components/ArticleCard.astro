---
import { resolveArticleAccent } from "../lib/articles";
import { renderCardArtSvg } from "../lib/card-art";

const entry = Astro.props.entry as any;
const index = (Astro.props.index as number | undefined) ?? 0;
const number = String(index + 1).padStart(2, "0");
const svgMarkup = renderCardArtSvg({
  slug: entry.id,
  tags: entry.data.tags ?? [],
  accent: resolveArticleAccent(entry),
});
---

<a
  href={`/articles/${entry.id}`}
  class="block-box block-box-shadow block-box-hover group flex h-full flex-col"
>
  <div class="relative aspect-[16/10] overflow-hidden rule-b" style="border-color: var(--border);">
    <div class="absolute inset-0" set:html={svgMarkup}></div>
    <span class="absolute left-3 top-3 chip chip-accent">
      Article / {number}
    </span>
  </div>
  <div class="flex flex-1 flex-col gap-4 p-5">
    <div class="flex items-center justify-between gap-3 font-mono text-[0.68rem] uppercase tracking-[0.12em]" style="color: var(--fg-muted);">
      <span>{entry.data.date}</span>
      {entry.data.readTime ? <span>{entry.data.readTime}</span> : null}
    </div>
    <div class="space-y-2">
      <h3 class="display text-xl leading-[1.05] transition group-hover:underline" style="text-decoration-color: var(--accent); text-decoration-thickness: 3px; text-underline-offset: 4px;">
        {entry.data.title}
      </h3>
      <p class="text-sm leading-relaxed" style="color: var(--fg-muted);">{entry.data.description}</p>
    </div>
    {entry.data.tags && entry.data.tags.length ? (
      <div class="mt-auto flex flex-wrap gap-1.5 pt-2">
        {entry.data.tags.map((tag: string) => (
          <span class="chip">{tag}</span>
        ))}
      </div>
    ) : null}
  </div>
</a>
