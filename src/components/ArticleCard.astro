---
import { resolveArticleAccent } from "../lib/articles";
import { renderCardArtSvg } from "../lib/card-art";
const entry = Astro.props.entry as any;
const index = (Astro.props.index as number | undefined) ?? 0;
const number = String(index + 1).padStart(2, "0");
const svgMarkup = renderCardArtSvg({ slug: entry.id, tags: entry.data.tags ?? [], accent: resolveArticleAccent(entry) });
---

<a href={`/articles/${entry.id}`} class="group grid h-full grid-rows-[auto_1fr]">
  <div class="block-box block-box-shadow block-box-hover relative aspect-[16/9] overflow-hidden" style="background: var(--surface-2);">
    <div class="absolute inset-0 transition duration-500 group-hover:scale-[1.025]" set:html={svgMarkup}></div>
    <span class="card-index absolute left-3 top-3">A/{number}</span>
  </div>
  <div class="flex flex-col gap-4 border-t-0 py-5">
    <div class="meta-row justify-between"><span>{entry.data.date}</span>{entry.data.readTime ? <span>{entry.data.readTime}</span> : null}</div>
    <h3 class="display text-3xl transition duration-300 group-hover:text-[var(--accent)] md:text-[2.15rem]">{entry.data.title}</h3>
    <p class="text-sm leading-relaxed" style="color: var(--fg-muted);">{entry.data.description}</p>
    {entry.data.tags?.length ? <div class="mt-auto flex flex-wrap gap-1.5 pt-2">{entry.data.tags.slice(0, 4).map((tag: string) => <span class="chip">{tag}</span>)}</div> : null}
  </div>
</a>
