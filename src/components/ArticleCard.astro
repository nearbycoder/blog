---
import { articleImage, formatDate } from "../lib/media";
const { entry, heading = "h3" } = Astro.props;
const Heading = heading as "h2" | "h3";
---

<a href={`/articles/${entry.id}`} class="article-card">
  <div class="story-image">
    <img
      src={articleImage(entry)}
      alt=""
      width="720"
      height="424"
      loading="lazy"
    />
  </div>
  <div class="meta-row">
    <span class="meta-topic">{entry.data.tags?.[0] ?? "Engineering"}</span><time
      datetime={entry.data.date}>{formatDate(entry.data.date)}</time
    >
  </div>
  <Heading>{entry.data.title}</Heading>
  <p>{entry.data.description}</p>
  <span class="read-more"
    >{entry.data.readTime ?? "Read article"}
    <span aria-hidden="true">↗</span></span
  >
</a>
