---
import { technologySlug } from "../lib/technologies";
import { labs } from "../data/labs";
import ProjectStory from "./ProjectStory.astro";
import BlogLayout from "../layouts/BlogLayout.astro";
import Icon from "./Icon.astro";
import { render, type CollectionEntry } from "astro:content";
import {
  formatDate,
  mediaUrl,
  projectImage,
  projectImageAlt,
} from "../lib/media";
import { isGame, type WorkEntry } from "../lib/work";

interface Props {
  entry: WorkEntry;
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const image = projectImage(entry);
const lab = labs.find((lab) => lab.project === entry.id);
const game = isGame(entry)
  ? (entry.data as CollectionEntry<"games">["data"])
  : undefined;
const index = game
  ? { href: "/games", noun: "games", label: "Game details" }
  : { href: "/projects", noun: "projects", label: "Project details" };
const linkLabel = game ? "Play in your browser" : "Visit project";
---

<BlogLayout title={entry.data.title} description={entry.data.summary}>
  <article>
    <header class="reading-header">
      <a href={index.href} class="nav-link">← All {index.noun}</a><h1
        class="display"
      >
        {entry.data.title}
      </h1><p class="deck">{entry.data.summary}</p><div
        class="mt-7 flex flex-wrap gap-3"
      >
        {
          entry.data.link && (
            <a
              href={entry.data.link}
              class="btn btn-accent"
              target="_blank"
              rel="noreferrer"
            >
              {linkLabel} <Icon name="external" />
            </a>
          )
        }{
          game?.download && (
            <a
              href={game.download}
              class:list={["btn", !entry.data.link && "btn-accent"]}
              target="_blank"
              rel="noreferrer"
            >
              Download <Icon name="external" />
            </a>
          )
        }{
          game && entry.data.demoVideos.length > 0 && (
            <a href="#project-demos-heading" class="btn">
              Watch the trailer
            </a>
          )
        }{
          entry.data.githubLink && (
            <a
              href={entry.data.githubLink}
              class="btn"
              target="_blank"
              rel="noreferrer"
            >
              View source <Icon name="external" />
            </a>
          )
        }
      </div>
    </header>
    {
      image && (
        <figure class="reading-cover">
          <img
            src={image}
            alt={projectImageAlt(entry)}
            width="1200"
            height="600"
            fetchpriority="high"
            style="object-fit:contain"
          />
          {entry.data.imageCaption && (
            <figcaption>{entry.data.imageCaption}</figcaption>
          )}
        </figure>
      )
    }
    <div class="reading-layout">
      <aside class="reading-sidebar work-sidebar">
        <p class="label">{index.label}</p>
        <dl class:list={["work-facts", game && "game-facts"]}>
          <div>
            <dt class="label">Role</dt>
            <dd>{entry.data.role}</dd>
          </div>
          {
            game && (
              <>
                <div>
                  <dt class="label">Genre</dt>
                  <dd>{game.genre}</dd>
                </div>
                <div>
                  <dt class="label">Plays on</dt>
                  <dd>{game.platforms.join(" · ")}</dd>
                </div>
                <div>
                  <dt class="label">Engine</dt>
                  <dd>{game.engine}</dd>
                </div>
              </>
            )
          }
          {
            entry.data.createdAt ? (
              <div class="project-created">
                <dt class="label">Repository created</dt>
                <dd>
                  <time
                    datetime={entry.data.createdAt}
                    title="GitHub repository creation date (UTC)"
                  >
                    {formatDate(entry.data.createdAt)}
                  </time>
                </dd>
              </div>
            ) : (
              <div>
                <dt class="label">Year</dt>
                <dd>{entry.data.year}</dd>
              </div>
            )
          }
        </dl>
        <div class="work-stack">
          {
            entry.data.stack.map((item) => (
              <a class="chip" href={`/technologies/${technologySlug(item)}/`}>
                {item}
              </a>
            ))
          }
        </div>
      </aside><div>
        {
          entry.data.impact && (
            <div
              class="mb-8 border-l-2 pl-6"
              style="border-color:var(--accent)"
            >
              <>
                <p class="label mb-3">The outcome</p>
                <p class="text-xl leading-relaxed">{entry.data.impact}</p>
              </>
            </div>
          )
        }<div class="article-content"><Content /></div>
        {
          entry.data.demoVideos.length > 0 && (
            <section
              class="project-demos"
              aria-labelledby="project-demos-heading"
            >
              <h2 id="project-demos-heading">See it in action</h2>
              {entry.data.demoVideos.map((demo, index) => (
                <figure>
                  <h3>{demo.title}</h3>
                  <video
                    src={mediaUrl(demo.src)}
                    poster={demo.poster}
                    controls
                    preload="none"
                    playsinline
                    aria-label={demo.title}
                    aria-describedby={`project-demo-caption-${index}`}
                  >
                    <a href={mediaUrl(demo.src)}>Watch {demo.title}</a>
                  </video>
                  <figcaption id={`project-demo-caption-${index}`}>
                    {demo.caption}
                    {demo.original && (
                      <a href={demo.original} target="_blank" rel="noreferrer">
                        Full-resolution original on GitHub
                      </a>
                    )}
                  </figcaption>
                </figure>
              ))}
            </section>
          )
        }
        <div class="reading-end">
          <a href={index.href} class="text-link"
            >Explore more {index.noun} <Icon name="arrow" /></a
          >
        </div>
      </div>
    </div>
  </article>
  {
    lab && (
      <section class="lab-source">
        <>
          <h2>Try a piece of this {game ? "game" : "project"}</h2>
          <p>{lab.description}</p>
          <a href={`/lab/${lab.slug}`} class="text-link">
            {lab.title} →
          </a>
        </>
      </section>
    )
  }
  <ProjectStory projectId={entry.id} />
</BlogLayout>

<style>
  .reading-cover figcaption,
  .project-demos figcaption {
    margin-top: 12px;
    color: var(--fg-muted);
    font-size: 0.875rem;
    line-height: 1.6;
  }
  .reading-cover figcaption {
    padding: 0 8px 8px;
  }
  .work-facts {
    display: grid;
    gap: 14px;
    margin: 16px 0 0;
  }
  .work-facts dd {
    margin: 4px 0 0;
    font-size: 0.875rem;
    overflow-wrap: anywhere;
  }
  .work-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 24px;
  }
  /* The shared phone sidebar is a wrapping row for article tools; project and
     game details read better as a two-column list. */
  @media (max-width: 767px) {
    .reading-sidebar.work-sidebar {
      display: block;
    }
    .work-facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px 20px;
    }
    .work-stack {
      margin-top: 20px;
    }
  }
  .project-demos figcaption a {
    display: block;
    margin-top: 6px;
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .article-content :global(.project-media-gallery) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 180px), 1fr));
    gap: 16px;
    align-items: start;
  }
  .article-content :global(figure) {
    margin-inline: 0;
  }
  .article-content :global(.project-media-gallery figure) {
    margin: 0;
  }
  .article-content :global(figcaption) {
    margin-top: 10px;
    color: var(--fg-muted);
    font-size: 0.875rem;
    line-height: 1.6;
  }
  .project-demos {
    margin-top: 48px;
  }
  .project-demos h2 {
    font-family: var(--font-display);
    font-size: 2rem;
    line-height: 1.2;
  }
  .project-demos figure {
    margin-top: 28px;
  }
  .project-demos h3 {
    margin-bottom: 12px;
    font-size: 1.125rem;
  }
  .project-demos video {
    display: block;
    width: 100%;
    height: auto;
    max-height: 600px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
</style>
