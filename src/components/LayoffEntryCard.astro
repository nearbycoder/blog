---
const entry = Astro.props.entry as any;
const index = (Astro.props.index as number | undefined) ?? 0;
const number = String(index + 1).padStart(2, "0");
const cadenceLabel = entry.data.week
  ? `W${entry.data.week}`
  : entry.data.day
    ? `D${entry.data.day}`
    : null;
const hasDistinctSiteUrl =
  typeof entry.data.siteUrl === "string" &&
  typeof entry.data.repoUrl === "string" &&
  entry.data.siteUrl !== entry.data.repoUrl;
---

<article class="block-box block-box-shadow block-box-hover group flex h-full flex-col overflow-hidden">
  <div class="flex items-center justify-between gap-3 rule-b px-5 py-4" style="border-color: var(--border); background: color-mix(in srgb, var(--accent-2) 28%, var(--surface));">
    <span class="card-index">
      {number}
    </span>
    <span class="font-mono text-[0.7rem] font-bold uppercase tracking-normal" style="color: var(--fg-muted);">
      {entry.data.date}{cadenceLabel ? ` · ${cadenceLabel}` : ""} · {entry.data.status}
    </span>
  </div>

  {entry.data.image ? (
    <div class="relative aspect-[16/9] overflow-hidden rule-b" style="border-color: var(--border); background: var(--surface-2);">
      <img
        src={entry.data.image}
        alt={entry.data.title}
        loading="lazy"
        class="h-full w-full object-cover"
      />
    </div>
  ) : null}

  <div class="flex flex-1 flex-col gap-4 p-5 md:p-6">
    <div class="space-y-2">
      <a
        href={`/layoff/${entry.id}`}
        class="display block text-3xl leading-[1] transition group-hover:underline md:text-4xl"
        style="text-decoration-color: var(--accent); text-decoration-thickness: 3px; text-underline-offset: 4px;"
      >
        {entry.data.title}
      </a>
      <p class="text-sm leading-relaxed" style="color: var(--fg-muted);">{entry.data.summary}</p>
    </div>

    <div class="flex flex-wrap gap-1.5">
      {entry.data.stack.map((item: string) => (
        <span class="chip">{item}</span>
      ))}
    </div>

    <div class="mt-auto flex flex-wrap gap-2 pt-2">
      {hasDistinctSiteUrl ? (
        <a
          href={entry.data.siteUrl}
          target="_blank"
          rel="noreferrer"
          class="btn btn-accent"
        >
          Visit ↗
        </a>
      ) : null}
      <a
        href={entry.data.repoUrl}
        target="_blank"
        rel="noreferrer"
        class="btn"
      >
        Code ↗
      </a>
    </div>
  </div>
</article>
