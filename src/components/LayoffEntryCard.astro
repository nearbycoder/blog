---
import { formatDate } from "../lib/media";
const { entry } = Astro.props;
---

<article class="log-card">
  {
    entry.data.image ? (
      <img
        src={entry.data.image}
        alt=""
        width="100"
        height="100"
        loading="lazy"
      />
    ) : (
      <div class="log-placeholder" aria-hidden="true">
        {entry.data.week ? `W${entry.data.week}` : "↗"}
      </div>
    )
  }
  <div>
    <div class="meta-row">
      <time datetime={entry.data.date}>{formatDate(entry.data.date)}</time><span
        class="meta-topic">{entry.data.status}</span
      >
    </div>
    <h3><a href={`/layoff/${entry.id}`}>{entry.data.title}</a></h3>
    <p>{entry.data.summary}</p>
    <a href={`/layoff/${entry.id}`} class="text-link"
      >Read update <span aria-hidden="true">→</span></a
    >
  </div>
</article>
