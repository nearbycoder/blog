---
import { site } from "../data/site";
import ThemeToggle from "./ThemeToggle.astro";

const pathname = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === "/") return pathname === "/";
  return pathname === href || pathname.startsWith(`${href}/`);
};
---

<header class="relative z-30 border-b" style="border-color: var(--border); background: color-mix(in srgb, var(--bg) 88%, transparent); backdrop-filter: blur(16px);">
  <div class="mx-auto flex w-full max-w-[1180px] flex-wrap items-center justify-between gap-4 px-5 py-4 sm:px-8">
    <a href="/" class="group flex min-w-0 items-center gap-3" aria-label="Nearbycoder home">
      <img
        src="/logo.jpeg"
        alt="Nearbycoder avatar"
        width="40"
        height="40"
        loading="eager"
        class="h-11 w-11 shrink-0 rotate-[-2deg] rounded-[7px] object-cover transition group-hover:rotate-2"
        style="border: 1.5px solid var(--border); box-shadow: 4px 4px 0 0 color-mix(in srgb, var(--shadow-color) 82%, transparent);"
      />
      <div class="min-w-0 leading-tight">
        <p class="display truncate text-[1.65rem] leading-none">Nearbycoder</p>
        <p class="font-mono truncate text-[0.66rem] font-bold tracking-normal uppercase" style="color: var(--fg-muted);">{site.role}</p>
      </div>
    </a>

    <nav class="hidden items-center gap-5 lg:flex">
      {site.nav.map((item: { label: string; href: string }) => (
        <a
          href={item.href}
          class="nav-link"
          aria-current={isActive(item.href) ? "page" : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="ml-auto flex flex-wrap items-center justify-end gap-2">
      <button
        type="button"
        class="btn btn-ghost"
        data-command-trigger
        aria-label="Open command palette"
      >
        <span class="font-mono">⌘K</span>
        <span class="hidden sm:inline">Find</span>
      </button>
      <ThemeToggle />
      <a
        href="/resume.pdf"
        target="_blank"
        rel="noreferrer"
        class="btn btn-accent"
      >
        Resume →
      </a>
    </div>
  </div>

  <nav class="mx-auto flex w-full max-w-[1180px] flex-wrap gap-x-5 gap-y-2 px-5 pb-4 sm:px-8 lg:hidden">
    {site.nav.map((item: { label: string; href: string }) => (
      <a
        href={item.href}
        class="nav-link"
        aria-current={isActive(item.href) ? "page" : undefined}
      >
        {item.label}
      </a>
    ))}
  </nav>
</header>

<script is:inline>
  (() => {
    document.querySelectorAll("[data-command-trigger]").forEach((btn) => {
      btn.addEventListener("click", (event) => {
        event.preventDefault();
        const ev = new KeyboardEvent("keydown", {
          key: "k",
          metaKey: true,
          bubbles: true,
        });
        document.dispatchEvent(ev);
      });
    });
  })();
</script>
