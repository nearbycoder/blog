---
import { site } from "../data/site";
import ThemeToggle from "./ThemeToggle.astro";
import Icon from "./Icon.astro";
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) =>
  pathname === href || pathname.startsWith(`${href}/`);
---

<header class="site-header">
  <div class="site-container header-inner">
    <a href="/" class="brand" aria-label="Nearbycoder home">
      <svg
        viewBox="0 0 24 24"
        class="brand-mark"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        aria-hidden="true"
        ><circle cx="12" cy="12" r="7"></circle><path
          d="M12 1v5M12 18v5M1 12h5M18 12h5"></path><rect
          x="9.5"
          y="9.5"
          width="5"
          height="5"
          fill="currentColor"
          stroke="none"></rect></svg
      >
      <span>NEARBYCODER</span>
    </a>
    <nav class="desktop-nav" aria-label="Main navigation">
      {
        site.nav.map((item) => (
          <a
            href={item.href}
            class="nav-link"
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="header-actions">
      <button
        class="btn btn-ghost"
        type="button"
        data-command-trigger
        aria-label="Open search"
        ><Icon name="search" /><span class="search-label">Search</span><kbd
          >⌘ K</kbd
        ></button
      >
      <ThemeToggle />
      <button
        class="btn btn-ghost icon-button menu-toggle"
        type="button"
        data-menu-toggle
        aria-label="Toggle navigation"
        aria-controls="mobile-navigation"
        aria-expanded="false"><Icon name="menu" /></button
      >
    </div>
  </div>
  <nav
    id="mobile-navigation"
    class="mobile-nav"
    aria-label="Mobile navigation"
    hidden
  >
    {
      [...site.nav,...site.explore].map((item) => (
        <a
          href={item.href}
          class="nav-link"
          aria-current={isActive(item.href) ? "page" : undefined}
        >
          {item.label}
        </a>
      ))
    }
  </nav>
</header>
<script>
  const toggle =
    document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const nav = document.getElementById("mobile-navigation");
  const close = () => {
    if (nav) nav.hidden = true;
    toggle?.setAttribute("aria-expanded", "false");
  };
  toggle?.addEventListener("click", () => {
    if (!nav) return;
    nav.hidden = !nav.hidden;
    toggle.setAttribute("aria-expanded", String(!nav.hidden));
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && nav && !nav.hidden) {
      close();
      toggle?.focus();
    }
  });
  matchMedia("(min-width:768px)").addEventListener("change", close);
</script>
