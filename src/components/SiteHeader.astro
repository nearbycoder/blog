---
import { site } from "../data/site";
import ThemeToggle from "./ThemeToggle.astro";
---

<header class="relative z-30">
  <div class="mx-auto flex w-full max-w-6xl flex-wrap items-start justify-between gap-3 px-4 py-4 sm:items-center sm:px-6 sm:py-6">
    <a href="/" class="flex min-w-0 items-center gap-3">
      <img
        src="/logo.jpeg"
        alt="Nearbycoder avatar"
        class="h-9 w-9 rounded-xl border border-white/10 object-cover"
        width="36"
        height="36"
        loading="eager"
      />
      <div class="min-w-0">
        <p class="truncate text-sm uppercase tracking-[0.3em] text-[color:var(--fog-500)]">Nearbycoder</p>
        <p class="truncate text-sm font-semibold text-[color:var(--mist-100)] sm:text-base">{site.name}</p>
      </div>
    </a>
    <nav class="hidden items-center gap-6 text-sm uppercase tracking-[0.2em] text-[color:var(--mist-200)] lg:flex">
      {site.nav.map((item: { label: string; href: string }) => (
        <a href={item.href} class="transition hover:text-white">
          {item.label}
        </a>
      ))}
    </nav>
    <div class="ml-auto flex flex-wrap items-center justify-end gap-2 sm:gap-3">
      <ThemeToggle />
      <a
        href="/resume.pdf"
        target="_blank"
        rel="noreferrer"
        class="rounded-full border px-3 py-2 text-xs uppercase tracking-[0.16em] text-white transition hover:border-white/60 hover:bg-white/20 sm:px-4 sm:tracking-[0.2em]"
        style="border-color: var(--accent-cyan); background-color: var(--glow);"
      >
        Resume
      </a>
      <a
        href="/articles"
        class="hidden rounded-full border border-white/10 bg-white/5 px-4 py-2 text-xs uppercase tracking-[0.2em] text-white transition hover:border-white/20 lg:inline-flex"
      >
        Read
      </a>
    </div>
  </div>
  <nav class="mx-auto flex w-full max-w-6xl flex-wrap gap-4 px-4 pb-4 text-xs uppercase tracking-[0.2em] text-[color:var(--mist-200)] sm:px-6 lg:hidden">
    {site.nav.map((item: { label: string; href: string }) => (
      <a href={item.href} class="transition hover:text-white">
        {item.label}
      </a>
    ))}
  </nav>
</header>
