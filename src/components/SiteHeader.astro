---
import { site } from "../data/site";
import ThemeToggle from "./ThemeToggle.astro";
---

<header class="relative z-30">
  <div class="mx-auto flex w-full max-w-6xl items-center justify-between px-6 py-6">
    <a href="/" class="flex items-center gap-3">
      <img
        src="/logo.jpeg"
        alt="Nearbycoder avatar"
        class="h-9 w-9 rounded-xl border border-white/10 object-cover"
        width="36"
        height="36"
        loading="eager"
      />
      <div>
        <p class="text-sm uppercase tracking-[0.3em] text-[color:var(--fog-500)]">Nearbycoder</p>
        <p class="text-base font-semibold text-[color:var(--mist-100)]">{site.name}</p>
      </div>
    </a>
    <nav class="hidden items-center gap-6 text-sm uppercase tracking-[0.2em] text-[color:var(--mist-200)] md:flex">
      {site.nav.map((item: { label: string; href: string }) => (
        <a href={item.href} class="transition hover:text-white">
          {item.label}
        </a>
      ))}
    </nav>
    <div class="flex items-center gap-3">
      <ThemeToggle />
      <a
        href="/articles"
        class="hidden rounded-full border border-white/10 bg-white/5 px-4 py-2 text-xs uppercase tracking-[0.2em] text-white transition hover:border-white/20 md:inline-flex"
      >
        Read
      </a>
    </div>
  </div>
  <nav class="mx-auto flex w-full max-w-6xl flex-wrap gap-4 px-6 pb-4 text-xs uppercase tracking-[0.2em] text-[color:var(--mist-200)] md:hidden">
    {site.nav.map((item: { label: string; href: string }) => (
      <a href={item.href} class="transition hover:text-white">
        {item.label}
      </a>
    ))}
  </nav>
</header>
