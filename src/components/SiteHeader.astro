---
import { site } from "../data/site";
import ThemeToggle from "./ThemeToggle.astro";

const pathname = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === "/") return pathname === "/";
  return pathname === href || pathname.startsWith(`${href}/`);
};
---

<header class="relative z-30 rule-b-heavy" style="border-color: var(--border);">
  <div class="mx-auto flex w-full max-w-6xl flex-wrap items-center justify-between gap-4 px-5 py-5 sm:px-8">
    <a href="/" class="group flex min-w-0 items-center gap-3">
      <img
        src="/logo.jpeg"
        alt="Nearbycoder avatar"
        width="40"
        height="40"
        loading="eager"
        class="h-10 w-10 shrink-0 object-cover"
        style="border: 2px solid var(--border); box-shadow: 3px 3px 0 0 var(--shadow-color);"
      />
      <div class="min-w-0 leading-tight">
        <p class="label-strong truncate">Nearbycoder</p>
        <p class="font-mono truncate text-[0.68rem] tracking-[0.14em] uppercase" style="color: var(--fg-muted);">{site.name}</p>
      </div>
    </a>

    <nav class="hidden items-center gap-6 lg:flex">
      {site.nav.map((item: { label: string; href: string }) => (
        <a
          href={item.href}
          class="nav-link"
          aria-current={isActive(item.href) ? "page" : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="ml-auto flex flex-wrap items-center justify-end gap-2">
      <button
        type="button"
        class="btn btn-ghost"
        data-command-trigger
        aria-label="Open command palette"
      >
        <span class="font-mono">⌘K</span>
        <span class="hidden sm:inline">Search</span>
      </button>
      <ThemeToggle />
      <a
        href="/resume.pdf"
        target="_blank"
        rel="noreferrer"
        class="btn btn-accent"
      >
        Resume →
      </a>
    </div>
  </div>

  <nav class="mx-auto flex w-full max-w-6xl flex-wrap gap-x-5 gap-y-2 rule-b px-5 pb-3 sm:px-8 lg:hidden" style="border-color: var(--border);">
    {site.nav.map((item: { label: string; href: string }) => (
      <a
        href={item.href}
        class="nav-link"
        aria-current={isActive(item.href) ? "page" : undefined}
      >
        {item.label}
      </a>
    ))}
  </nav>
</header>

<script is:inline>
  (() => {
    document.querySelectorAll("[data-command-trigger]").forEach((btn) => {
      btn.addEventListener("click", (event) => {
        event.preventDefault();
        const ev = new KeyboardEvent("keydown", {
          key: "k",
          metaKey: true,
          bubbles: true,
        });
        document.dispatchEvent(ev);
      });
    });
  })();
</script>
