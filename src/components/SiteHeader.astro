---
import ThemeToggle from "./ThemeToggle.astro";
import Icon from "./Icon.astro";
import { sections, locate } from "../lib/sections";
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const here = locate(pathname);
const linkState = (href: string) => {
  const target = href.replace(/\/$/, "") || "/";
  if (pathname === target) return "page";
  return here?.link.href === href ? "true" : undefined;
};
---

<header class="site-header">
  <div class="site-container header-inner">
    <a href="/" class="brand" aria-label="Nearbycoder home">
      <svg
        viewBox="0 0 32 32"
        class="brand-mark"
        fill="none"
        stroke="currentColor"
        stroke-width="1.4"
        aria-hidden="true"
        ><path
          d="M16 2.5c7.6 0 13.5 5.2 13.5 12.6 0 8-6.6 14.4-14.2 14.4C7.9 29.5 2.5 23.5 2.5 16 2.5 8.6 8.6 2.5 16 2.5Z"
        ></path><path
          d="M16.4 7.2c5 0 8.7 3.6 8.7 8.4 0 5.2-4.3 9.2-9.3 9.2-4.6 0-8-3.8-8-8.6 0-4.9 3.8-9 8.6-9Z"
          opacity=".7"></path><path
          d="M16.6 11.6c2.6 0 4.4 1.9 4.4 4.3 0 2.7-2.2 4.6-4.8 4.6-2.3 0-4-1.9-4-4.3 0-2.5 1.9-4.6 4.4-4.6Z"
          opacity=".5"></path><circle
          class="brand-pin"
          cx="16.3"
          cy="16"
          r="2.3"
          stroke="none"></circle></svg
      >
      <span class="brand-word">Nearby<em>coder</em></span>
    </a>
    <nav class="desktop-nav" aria-label="Main navigation">
      <ul class="section-menus">
        {
          sections.map((section) => (
            <li
              class="section-menu"
              data-section-menu
              data-section={section.id}
            >
              <button
                type="button"
                class="section-trigger"
                aria-expanded="false"
                aria-controls={`section-menu-${section.id}`}
                data-current={
                  here?.section.id === section.id ? "true" : undefined
                }
              >
                <span class="section-number" aria-hidden="true">
                  {section.number}
                </span>
                {section.label}
                <Icon name="chevronDown" />
              </button>
              <div
                id={`section-menu-${section.id}`}
                class="section-panel"
                hidden
              >
                <div class="site-container section-panel-inner">
                  <div class="section-panel-intro">
                    <p class="label">
                      {section.number} · {section.title}
                    </p>
                    <p class="section-panel-blurb">{section.blurb}</p>
                  </div>
                  <ul class="section-panel-links">
                    {section.links.map((link) => (
                      <li>
                        <a href={link.href} aria-current={linkState(link.href)}>
                          <strong>{link.label}</strong>
                          <span>{link.note}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="header-actions">
      <button
        class="btn btn-ghost"
        type="button"
        data-command-trigger
        aria-label="Open search"
        ><Icon name="search" /><span class="search-label">Search</span><kbd
          >⌘ K</kbd
        ></button
      >
      <ThemeToggle />
      <button
        class="btn btn-ghost icon-button menu-toggle"
        type="button"
        data-menu-toggle
        aria-label="Toggle navigation"
        aria-controls="mobile-navigation"
        aria-expanded="false"><Icon name="menu" /></button
      >
    </div>
  </div>
  <nav
    id="mobile-navigation"
    class="mobile-nav"
    aria-label="Mobile navigation"
    hidden
  >
    {
      sections.map((section) => (
        <div class="mobile-nav-group">
          <p class="label">
            {section.number} · {section.label}
          </p>
          {section.links.map((link) => (
            <a
              href={link.href}
              class="nav-link"
              aria-current={linkState(link.href)}
            >
              {link.label}
            </a>
          ))}
        </div>
      ))
    }
    <a href="/desktop" class="nav-link mobile-nav-desktop" target="_top"
      >Desktop (experimental)</a
    >
  </nav>
</header>
{
  here && (
    <nav
      class="section-nav"
      aria-label={`${here.section.label} section`}
      data-section={here.section.id}
    >
      <div class="site-container section-nav-inner">
        <a href={here.section.home} class="section-nav-title">
          <span class="section-number" aria-hidden="true">
            {here.section.number}
          </span>
          {here.section.label}
        </a>
        <ul class="section-nav-links">
          {here.section.links.map((link) => (
            <li>
              <a href={link.href} aria-current={linkState(link.href)}>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </nav>
  )
}
<script>
  const toggle =
    document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const nav = document.getElementById("mobile-navigation");
  const close = () => {
    if (nav) nav.hidden = true;
    toggle?.setAttribute("aria-expanded", "false");
  };
  toggle?.addEventListener("click", () => {
    if (!nav) return;
    nav.hidden = !nav.hidden;
    toggle.setAttribute("aria-expanded", String(!nav.hidden));
  });

  const menus = [
    ...document.querySelectorAll<HTMLElement>("[data-section-menu]"),
  ].map((menu) => ({
    menu,
    trigger: menu.querySelector<HTMLButtonElement>("button")!,
    panel: menu.querySelector<HTMLElement>(".section-panel")!,
  }));
  const setOpen = (target: (typeof menus)[number] | undefined) => {
    for (const item of menus) {
      const open = item === target;
      item.panel.hidden = !open;
      item.trigger.setAttribute("aria-expanded", String(open));
    }
  };
  for (const item of menus) {
    item.trigger.addEventListener("click", () =>
      setOpen(item.panel.hidden ? item : undefined),
    );
    // Tabbing out of an open menu closes it; clicks are handled below.
    item.menu.addEventListener("focusout", (event) => {
      const next = event.relatedTarget as Node | null;
      if (next && !item.menu.contains(next) && !item.panel.hidden)
        setOpen(undefined);
    });
  }
  document.addEventListener("click", (event) => {
    if (!menus.some(({ menu }) => menu.contains(event.target as Node)))
      setOpen(undefined);
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    const open = menus.find(({ panel }) => !panel.hidden);
    if (open) {
      setOpen(undefined);
      open.trigger.focus();
    } else if (nav && !nav.hidden) {
      close();
      toggle?.focus();
    }
  });
  matchMedia("(min-width:768px)").addEventListener("change", (event) => {
    if (event.matches) close();
    else setOpen(undefined);
  });

  // Keep the current page visible in the scrollable section strip on phones.
  const current = document.querySelector<HTMLElement>(
    ".section-nav [aria-current]",
  );
  const strip = current?.closest("ul");
  if (current && strip && strip.scrollWidth > strip.clientWidth)
    strip.scrollLeft =
      current.offsetLeft - (strip.clientWidth - current.offsetWidth) / 2;
</script>
