---
import Icon from "./Icon.astro";
---

<section class="hero reveal">
  <p class="hero-kicker">
    <span aria-hidden="true"></span>Josh Hamilton · Member of Technical Staff at
    Augment Code
  </p>
  <div class="hero-grid">
    <div>
      <h1>Always curious.<span>Still building.</span></h1>
      <p class="hero-copy">
        Notes on engineering, making things with AI, and the human side of
        shipping software.
      </p>
    </div>
    <aside class="hero-profile">
      <img
        src="/images/portrait.webp"
        alt="Josh Hamilton"
        width="90"
        height="90"
        loading="eager"
      />
      <p>
        <strong>Hey, I’m Josh.</strong><br />Engineer, husband, and dad of two.
        Building useful things. Learning out loud.
      </p>
      <a href="/about" class="text-link"
        >A little about me <Icon name="arrow" /></a
      >
    </aside>
  </div>
  <div class="hero-bottom">
    <a href="/articles" class="btn btn-accent"
      >Explore the writing <Icon name="arrow" /></a
    ><a href="/projects" class="btn">Browse projects</a>
  </div>
</section>
