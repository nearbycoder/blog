---
import Icon from "./Icon.astro";
import { site } from "../data/site";
import { sections } from "../lib/sections";
---

<section class="hero reveal">
  <div class="hero-rays" aria-hidden="true"></div>
  <div class="hero-caustic" aria-hidden="true"></div>
  <p class="hero-kicker">
    <span class="hero-plaque">Nearby Atelier</span>
    <span class="hero-kicker-meta">Est. 2013 · {site.location}</span>
  </p>
  <div class="hero-grid">
    <div class="hero-main">
      <h1>
        <span class="hero-mask"
          ><span class="hero-line">Always curious.</span></span
        >
        <span class="hero-mask"
          ><span class="hero-sign">Still building.</span></span
        >
      </h1>
      <p class="hero-copy">
        Notes on engineering, making things with AI, and the human side of
        shipping software.
      </p>
      <div class="hero-actions">
        <a href="/articles" class="btn btn-accent"
          >Explore the writing <Icon name="arrow" /></a
        >
        <a href="/desktop" class="btn" target="_top">Enter Desktop</a>
        <a href="/projects" class="btn btn-ghost">Browse projects</a>
      </div>
    </div>
    <aside class="hero-profile">
      <div class="hero-medallion">
        <span class="medallion-rays" aria-hidden="true"></span>
        <span class="medallion-frame" aria-hidden="true"></span>
        <img
          src="/images/portrait.webp"
          alt="Josh Hamilton"
          width="148"
          height="148"
          loading="eager"
        />
      </div>
      <div class="hero-nameplate">
        <strong>Hey, I’m Josh.</strong>
        <span>Staff Software Engineer II · Harness</span>
      </div>
      <p>
        Engineer, husband, and dad of two. Building useful things. Learning out
        loud.
      </p>
      <a href="/about" class="text-link"
        >A little about me <Icon name="arrow" /></a
      >
    </aside>
  </div>
  <div class="hero-bottom">
    <div class="hero-directory">
      <div>
        <p class="label">Index</p>
        <ul class="hero-floors">
          {
            sections.map((section) => (
              <li data-section={section.id}>
                <a href={section.home}>
                  <span class="floor-number">{section.number}</span>
                  {section.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
    <dl class="hero-legend">
      <div>
        <dt>Studio</dt>
        <dd>{site.location}</dd>
      </div>
      <div>
        <dt>Coordinates</dt>
        <dd>36.154° N · 95.993° W</dd>
      </div>
    </dl>
  </div>
</section>
