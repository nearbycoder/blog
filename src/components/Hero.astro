---
import { site } from "../data/site";

const currentCompany = site.work[0]?.company;
const today = new Date().toISOString().slice(0, 10);
---

<section class="relative grid gap-12 pt-10 pb-14 md:grid-cols-[1.1fr_0.9fr] md:items-start reveal" style="--delay: 20ms;">
  <div class="space-y-8">
    <div class="flex flex-wrap items-center gap-2">
      <span class="chip chip-accent">● Online</span>
      <span class="chip">MTS @ Augment</span>
      <span class="chip">Tulsa, OK</span>
    </div>

    <h1 class="display text-5xl sm:text-6xl md:text-7xl lg:text-[5.5rem]">
      Software<br />
      <span class="marker">Engineer</span>,<br />
      loving<br />
      father.
    </h1>

    <p class="max-w-xl text-lg leading-relaxed" style="color: var(--fg-muted);">
      {site.hero.subtitle}
    </p>

    <div class="flex flex-wrap gap-3">
      <a href={site.hero.ctaPrimary.href} class="btn btn-accent">
        {site.hero.ctaPrimary.label} →
      </a>
      <a href={site.hero.ctaSecondary.href} class="btn">
        {site.hero.ctaSecondary.label}
      </a>
    </div>

    <div class="flex flex-wrap items-center gap-x-3 gap-y-2 font-mono text-xs uppercase tracking-[0.14em]" style="color: var(--fg-muted);">
      <span style="color: var(--fg);">{site.name}</span>
      <span class="dot dot-accent"></span>
      {currentCompany && (
        <a href="https://augmentcode.com" target="_blank" rel="noreferrer" class="nav-link">
          @ {currentCompany}
        </a>
      )}
    </div>

    <div class="flex flex-wrap gap-2">
      {site.socials.map((social: { label: string; url: string }) => (
        <a
          href={social.url}
          target="_blank"
          rel="noreferrer"
          class="chip"
        >
          {social.label} ↗
        </a>
      ))}
    </div>
  </div>

  <aside class="grid min-w-0 gap-4">
    <div class="block-box block-box-shadow p-5">
      <div class="flex items-center justify-between rule-b pb-3" style="border-color: var(--border);">
        <p class="label-strong">Status</p>
        <span class="font-mono text-xs" style="color: var(--fg-dim);">{today}</span>
      </div>
      <p class="mt-4 display text-2xl md:text-3xl">
        Building through layoffs <span class="marker">&amp;</span> AI shifts.
      </p>
      <p class="mt-3 font-mono text-xs leading-relaxed uppercase tracking-[0.1em]" style="color: var(--fg-muted);">
        Shipping weekly → measuring what sticks.
      </p>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div class="block-box p-4">
        <p class="label">Focus</p>
        <p class="mt-2 font-mono text-sm font-semibold uppercase tracking-[0.06em]" style="color: var(--fg);">Steady<br />Systems</p>
      </div>
      <div class="block-box p-4" style="background: var(--accent); color: var(--accent-fg); border-color: var(--border);">
        <p class="label" style="color: var(--accent-fg); opacity: 0.75;">Practice</p>
        <p class="mt-2 font-mono text-sm font-semibold uppercase tracking-[0.06em]">Clear on<br />Purpose</p>
      </div>
      <div class="block-box p-4">
        <p class="label">Speed</p>
        <p class="mt-2 font-mono text-sm font-semibold uppercase tracking-[0.06em]">Ship<br />Often</p>
      </div>
      <div class="block-box p-4">
        <p class="label">Signal</p>
        <p class="mt-2 font-mono text-sm font-semibold uppercase tracking-[0.06em]">Signal<br />&gt; Noise</p>
      </div>
    </div>
  </aside>
</section>
