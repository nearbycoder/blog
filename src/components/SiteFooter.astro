---
import { site } from "../data/site";
import Icon from "./Icon.astro";
---

<footer class="site-footer">
  <div class="site-container">
    <div class="footer-top">
      <div>
        <p class="display footer-title">
          Good things start<br />with <em>curiosity.</em>
        </p><a href="/rss.xml" class="text-link mt-5"
          ><Icon name="rss" /> Follow along via RSS</a
        >
      </div>
      <div>
        <p class="label">Explore</p><ul>
          {
            [...site.nav,...site.explore].map((item) => (
              <li>
                <a href={item.href} class="nav-link">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <p class="label">Elsewhere</p><ul>
          {
            site.socials.map((social) => (
              <li>
                <a
                  href={social.url}
                  class="nav-link"
                  target="_blank"
                  rel="noreferrer"
                >
                  {social.label}
                  <Icon name="external" />
                </a>
              </li>
            ))
          }<li>
            <a
              href="/resume.pdf"
              class="nav-link"
              target="_blank"
              rel="noreferrer">Resume <Icon name="external" /></a
            >
          </li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <p>© {new Date().getFullYear()} Josh Hamilton</p><p>
        Made with care. Shared with curiosity.
      </p><a href="#main-content">Back to top ↑</a>
    </div>
  </div>
</footer>
