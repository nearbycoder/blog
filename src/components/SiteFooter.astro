---
import { site } from "../data/site";
const year = new Date().getFullYear();
---

<footer class="mt-12 border-t" style="border-color: var(--border);">
  <div class="mx-auto w-full max-w-[1240px] px-5 py-10 sm:px-8">
    <div class="grid gap-10 md:grid-cols-[1.4fr_.7fr_.7fr]">
      <div>
        <p class="label">End transmission / {year}</p>
        <p class="display mt-4 max-w-xl text-4xl md:text-5xl">Still curious. Still building. Still taking notes.</p>
      </div>
      <div>
        <p class="label-strong mb-4">Index</p>
        <ul class="grid gap-2">
          {site.nav.map((item: { label: string; href: string }) => <li><a href={item.href} class="nav-link">{item.label}</a></li>)}
          <li><a href="/rss.xml" class="nav-link">RSS</a></li>
        </ul>
      </div>
      <div>
        <p class="label-strong mb-4">Elsewhere</p>
        <ul class="grid gap-2">
          {site.socials.map((social: { label: string; url: string }) => <li><a href={social.url} target="_blank" rel="noreferrer" class="nav-link">{social.label}</a></li>)}
          <li><a href="/resume.pdf" target="_blank" rel="noreferrer" class="nav-link">Resume.pdf</a></li>
        </ul>
      </div>
    </div>
    <div class="mt-12 flex flex-wrap items-center justify-between gap-4 border-t pt-4" style="border-color: var(--border-dim);">
      <p class="label">{site.name} / {site.location}</p>
      <p class="label">Built from scratch / Filed with care</p>
    </div>
  </div>
</footer>
