---
import { site } from "../data/site";
import { sections } from "../lib/sections";
import Icon from "./Icon.astro";
// The intro already links to /subscribe, so the About group skips it.
const groups = sections.map((section) => ({
  title: `${section.number} · ${section.label}`,
  links: section.links.filter((link) => link.href !== "/subscribe"),
}));
---

<footer class="site-footer">
  <div class="site-container">
    <div class="footer-top">
      <div class="footer-intro">
        <div>
          <p class="display footer-title">
            Good things start<br />with <em>curiosity.</em>
          </p>
          <p class="footer-coords">Surveyed from 36.154° N · 95.993° W</p>
        </div><a href="/subscribe" class="text-link mt-5"
          ><Icon name="rss" /> Follow along</a
        >
      </div>
      <nav class="footer-navigation" aria-label="Footer">
        {
          groups.map((group) => (
            <div class="footer-group">
              <>
                <h2 class="label">{group.title}</h2>
                <ul>
                  {group.links.map((item) => (
                    <li>
                      <a href={item.href} class="nav-link">
                        {item.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </>
            </div>
          ))
        }
        <div class="footer-group">
          <h2 class="label">Elsewhere</h2><ul>
            {
              site.socials.map((social) => (
                <li>
                  <a
                    href={social.url}
                    class="nav-link"
                    target="_blank"
                    rel="noreferrer"
                  >
                    {social.label}
                    <Icon name="external" />
                  </a>
                </li>
              ))
            }<li>
              <a
                href="/resume.pdf"
                class="nav-link"
                target="_blank"
                rel="noreferrer">Resume <Icon name="external" /></a
              >
            </li>
          </ul>
        </div>
      </nav>
    </div>
    <div class="footer-bottom">
      <p>© {new Date().getFullYear()} Josh Hamilton</p><p>
        Made with care. Shared with curiosity.
      </p><div class="footer-utilities">
        <button class="text-link" type="button" data-keyboard-help
          >Keyboard shortcuts</button
        ><a href="/desktop" target="_top">Desktop mode ↗</a><a
          href="#main-content">Back to top ↑</a
        >
      </div>
    </div>
  </div>
</footer>
