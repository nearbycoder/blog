---
import { site } from "../data/site";
---

<footer class="relative rule-heavy" style="border-color: var(--border);">
  <div class="mx-auto grid w-full max-w-6xl gap-8 px-5 py-10 sm:px-8 md:grid-cols-[1.2fr_1fr_1fr]">
    <div class="space-y-3">
      <p class="display text-3xl md:text-4xl">
        <span class="marker">{site.name}</span>
      </p>
      <p class="font-mono text-xs uppercase tracking-[0.14em]" style="color: var(--fg-muted);">
        {site.location} · {site.role}
      </p>
      <p class="font-mono text-xs uppercase tracking-[0.14em]" style="color: var(--fg-dim);">
        TESTING 2026
      </p>
    </div>

    <div class="space-y-3">
      <p class="label-strong">Pages</p>
      <ul class="grid gap-1.5 font-mono text-sm">
        {site.nav.map((item: { label: string; href: string }) => (
          <li>
            <a href={item.href} class="nav-link">{item.label}</a>
          </li>
        ))}
        <li>
          <a href="/rss.xml" class="nav-link">RSS</a>
        </li>
      </ul>
    </div>

    <div class="space-y-3">
      <p class="label-strong">Elsewhere</p>
      <ul class="grid gap-1.5 font-mono text-sm">
        {site.socials.map((social: { label: string; url: string }) => (
          <li>
            <a href={social.url} target="_blank" rel="noreferrer" class="nav-link">
              {social.label} ↗
            </a>
          </li>
        ))}
        <li>
          <a href="/resume.pdf" target="_blank" rel="noreferrer" class="nav-link">
            Resume.pdf ↗
          </a>
        </li>
      </ul>
    </div>
  </div>
</footer>
