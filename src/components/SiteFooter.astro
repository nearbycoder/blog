---
import { site } from "../data/site";
---

<footer class="relative mt-6 border-t" style="border-color: var(--border);">
  <div class="mx-auto grid w-full max-w-[1180px] gap-8 px-5 py-12 sm:px-8 md:grid-cols-[1.25fr_0.85fr_0.9fr]">
    <div class="sticker-note rotate-[-0.5deg] p-5">
      <p class="paper-strip">End notes</p>
      <p class="mt-4 display text-4xl md:text-5xl">
        {site.name}
      </p>
      <p class="font-mono text-xs uppercase tracking-normal" style="color: var(--fg-muted);">
        {site.location} · {site.role}
      </p>
      <p class="font-mono text-xs uppercase tracking-normal" style="color: var(--fg-dim);">
        © 2026 · Built from scratch · RSS ready
      </p>
    </div>

    <div class="space-y-3 pt-2">
      <p class="label-strong">Pages</p>
      <ul class="grid gap-1.5 font-mono text-sm">
        {site.nav.map((item: { label: string; href: string }) => (
          <li>
            <a href={item.href} class="nav-link">{item.label}</a>
          </li>
        ))}
        <li>
          <a href="/rss.xml" class="nav-link">RSS</a>
        </li>
      </ul>
    </div>

    <div class="space-y-3 pt-2">
      <p class="label-strong">Elsewhere</p>
      <ul class="grid gap-1.5 font-mono text-sm">
        {site.socials.map((social: { label: string; url: string }) => (
          <li>
            <a href={social.url} target="_blank" rel="noreferrer" class="nav-link">
              {social.label} ↗
            </a>
          </li>
        ))}
        <li>
          <a href="/resume.pdf" target="_blank" rel="noreferrer" class="nav-link">
            Resume.pdf ↗
          </a>
        </li>
      </ul>
    </div>
  </div>
</footer>
