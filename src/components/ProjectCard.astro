---
import { formatDate, projectImage } from "../lib/media";
import { isGame, workHref } from "../lib/work";
import Icon from "./Icon.astro";
const { project, heading = "h3" } = Astro.props;
const Heading = heading as "h2" | "h3";
const image = projectImage(project);
const href = workHref(project);
const game = isGame(project);
---

<article class="project-card">
  <a href={href} class="project-image" tabindex="-1" aria-hidden="true">
    {
      image ? (
        <img src={image} alt="" loading="lazy" width="720" height="450" />
      ) : (
        <span class="project-monogram">{project.data.title.slice(0, 2)}</span>
      )
    }
  </a>
  <div class="project-heading">
    <Heading><a href={href}>{project.data.title}</a></Heading>{
      project.data.createdAt ? (
        <time
          class="label"
          datetime={project.data.createdAt}
          title="Repository created"
          aria-label={`Repository created ${formatDate(project.data.createdAt)}`}
        >
          {formatDate(project.data.createdAt)}
        </time>
      ) : (
        <span class="label">{project.data.year}</span>
      )
    }
  </div>
  {
    game && (
      <p class="label game-meta">
        {project.data.genre} · {project.data.platforms.join(" · ")}
      </p>
    )
  }
  <p>{project.data.summary}</p>
  <div class="mt-4 flex flex-wrap gap-2">
    {
      project.data.stack
        .slice(0, 5)
        .map((item: string) => <span class="chip">{item}</span>)
    }
  </div>
  <div class="project-links">
    <a href={href} class="text-link"
      >{game ? "The game" : "The project"} <Icon name="arrow" /></a
    >{
      project.data.link && (
        <a
          href={project.data.link}
          class="nav-link"
          target="_blank"
          rel="noreferrer"
        >
          {game ? "Play" : "Visit site"} <Icon name="external" />
        </a>
      )
    }{
      game && !project.data.link && project.data.download && (
        <a
          href={project.data.download}
          class="nav-link"
          target="_blank"
          rel="noreferrer"
        >
          Download <Icon name="external" />
        </a>
      )
    }{
      project.data.githubLink && (
        <a
          href={project.data.githubLink}
          class="nav-link"
          target="_blank"
          rel="noreferrer"
        >
          Source
        </a>
      )
    }
  </div>
</article>

<style>
  .game-meta {
    margin-top: 8px;
  }
</style>
