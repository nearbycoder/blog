---
const project = Astro.props.project as any;
const index = (Astro.props.index as number | undefined) ?? 0;
const number = String(index + 1).padStart(2, "0");
---

<article class="block-box block-box-shadow block-box-hover group flex h-full flex-col">
  <div class="flex items-center justify-between gap-3 rule-b px-5 py-3" style="border-color: var(--border);">
    <span class="font-mono text-xs font-bold uppercase tracking-[0.14em]">
      PRJ / {number}
    </span>
    <span class="font-mono text-[0.7rem] uppercase tracking-[0.12em]" style="color: var(--fg-muted);">
      {project.data.year} · {project.data.role}
    </span>
  </div>

  <div class="flex flex-1 flex-col gap-4 p-5">
    <div class="space-y-2">
      <a
        href={`/projects/${project.id}`}
        class="display block text-2xl leading-[1.05] transition group-hover:underline"
        style="text-decoration-color: var(--accent); text-decoration-thickness: 3px; text-underline-offset: 4px;"
      >
        {project.data.title}
      </a>
      <p class="text-sm leading-relaxed" style="color: var(--fg-muted);">{project.data.summary}</p>
    </div>

    <div class="flex flex-wrap gap-1.5">
      {project.data.stack.map((item: string) => (
        <span class="chip">{item}</span>
      ))}
    </div>

    {project.data.link || project.data.githubLink ? (
      <div class="mt-auto flex flex-wrap gap-2 pt-2">
        {project.data.link ? (
          <a
            href={project.data.link}
            target="_blank"
            rel="noreferrer"
            class="btn btn-accent"
          >
            Visit ↗
          </a>
        ) : null}
        {project.data.githubLink ? (
          <a
            href={project.data.githubLink}
            target="_blank"
            rel="noreferrer"
            class="btn"
          >
            Code ↗
          </a>
        ) : null}
      </div>
    ) : null}
  </div>
</article>
