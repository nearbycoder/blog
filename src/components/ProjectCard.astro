---
import { projectImage } from "../lib/media";
import Icon from "./Icon.astro";
const { project, heading = "h3" } = Astro.props;
const Heading = heading as "h2" | "h3";
const image = projectImage(project);
---

<article class="project-card">
  <a
    href={`/projects/${project.id}`}
    class="project-image"
    tabindex="-1"
    aria-hidden="true"
  >
    {
      image ? (
        <img src={image} alt="" loading="lazy" width="720" height="450" />
      ) : (
        <span class="project-monogram">{project.data.title.slice(0, 2)}</span>
      )
    }
  </a>
  <div class="project-heading">
    <Heading
      ><a href={`/projects/${project.id}`}>{project.data.title}</a></Heading
    ><span class="label">{project.data.year}</span>
  </div>
  <p>{project.data.summary}</p>
  <div class="mt-4 flex flex-wrap gap-2">
    {
      project.data.stack
        .slice(0, 5)
        .map((item: string) => <span class="chip">{item}</span>)
    }
  </div>
  <div class="project-links">
    <a href={`/projects/${project.id}`} class="text-link"
      >The project <Icon name="arrow" /></a
    >{
      project.data.link && (
        <a
          href={project.data.link}
          class="nav-link"
          target="_blank"
          rel="noreferrer"
        >
          Visit site <Icon name="external" />
        </a>
      )
    }{
      project.data.githubLink && (
        <a
          href={project.data.githubLink}
          class="nav-link"
          target="_blank"
          rel="noreferrer"
        >
          Source
        </a>
      )
    }
  </div>
</article>
