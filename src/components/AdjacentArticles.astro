---
import { getCollection } from "astro:content";
import {
  isArticlePublished,
  compareArticlesByPublishDateDesc,
} from "../lib/articles";
import { formatDate } from "../lib/media";
const { id } = Astro.props;
const articles = (await getCollection("articles"))
  .filter((e) => isArticlePublished(e))
  .sort(compareArticlesByPublishDateDesc);
const index = articles.findIndex((e) => e.id === id);
const neighbors = [
  { label: "Older story", entry: articles[index + 1], rel: "prev" },
  {
    label: "Newer story",
    entry: index > 0 ? articles[index - 1] : undefined,
    rel: "next",
  },
];
---

<nav class="adjacent-articles" aria-label="Chronological article navigation">
  {
    neighbors.map(({ label, entry, rel }) => (
      <div>
        <p class="label">{label}</p>
        {entry ? (
          <>
            <a class="text-link" href={`/articles/${entry.id}/`} rel={rel}>
              {entry.data.title}
            </a>
            <p class="lab-hint">
              {formatDate(entry.data.publishedAt ?? entry.data.date)} ·{" "}
              {entry.data.readTime}
            </p>
          </>
        ) : (
          <p class="lab-hint">
            {rel === "prev"
              ? "You’ve reached the beginning of the archive."
              : "You’re reading the newest story."}
          </p>
        )}
      </div>
    ))
  }
</nav>
