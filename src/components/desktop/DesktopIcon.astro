---
import files from "@tabler/icons/outline/files.svg?raw";
import folder from "@tabler/icons/outline/folder.svg?raw";
import writing from "@tabler/icons/outline/file-text.svg?raw";
import code from "@tabler/icons/outline/code.svg?raw";
import journal from "@tabler/icons/outline/notebook.svg?raw";
import lab from "@tabler/icons/outline/flask.svg?raw";
import globe from "@tabler/icons/outline/world.svg?raw";
import close from "@tabler/icons/outline/x.svg?raw";
import minimize from "@tabler/icons/outline/minus.svg?raw";
import maximize from "@tabler/icons/outline/square.svg?raw";
import search from "@tabler/icons/outline/search.svg?raw";
import external from "@tabler/icons/outline/arrow-up-right.svg?raw";
import desktop from "@tabler/icons/outline/device-desktop.svg?raw";
import reset from "@tabler/icons/outline/layout.svg?raw";
import moon from "@tabler/icons/outline/sun-moon.svg?raw";
import game from "@tabler/icons/outline/device-gamepad-2.svg?raw";
import cards from "@tabler/icons/outline/cards.svg?raw";
import bug from "@tabler/icons/outline/bug.svg?raw";
import terminal from "@tabler/icons/outline/terminal-2.svg?raw";
import flag from "@tabler/icons/outline/flag.svg?raw";
import home from "@tabler/icons/outline/home.svg?raw";
import list from "@tabler/icons/outline/list.svg?raw";
import grid from "@tabler/icons/outline/layout-grid.svg?raw";
import apps from "@tabler/icons/outline/apps.svg?raw";
import chevronRight from "@tabler/icons/outline/chevron-right.svg?raw";
import chevronLeft from "@tabler/icons/outline/chevron-left.svg?raw";
import logout from "@tabler/icons/outline/logout.svg?raw";
import drive from "@tabler/icons/outline/device-sd-card.svg?raw";
import snake from "@tabler/icons/outline/route.svg?raw";
import pong from "@tabler/icons/outline/ball-tennis.svg?raw";
import puzzle from "@tabler/icons/outline/puzzle.svg?raw";
import calculator from "@tabler/icons/outline/calculator.svg?raw";
import palette from "@tabler/icons/outline/palette.svg?raw";
import timer from "@tabler/icons/outline/hourglass.svg?raw";
const icons = {
  calculator,
  palette,
  timer,
  snake,
  pong,
  puzzle,
  home,
  list,
  grid,
  apps,
  chevronRight,
  chevronLeft,
  logout,
  drive,
  game,
  cards,
  bug,
  terminal,
  flag,
  files,
  folder,
  writing,
  code,
  journal,
  lab,
  globe,
  close,
  minimize,
  maximize,
  search,
  external,
  desktop,
  reset,
  moon,
};
interface Props {
  name: keyof typeof icons;
}
---

<span
  class="desktop-icon"
  aria-hidden="true"
  set:html={icons[Astro.props.name]}
/>
