---
import Icon from "./Icon.astro";
interface Props {
  id: string;
  label: string;
  options: { value: string; label: string }[];
}
const { id, label, options } = Astro.props;
---

<custom-select id={id} class="custom-select">
  <label id={`${id}-label`} for={`${id}-trigger`}>{label}</label>
  <button
    id={`${id}-trigger`}
    class="custom-select-trigger"
    type="button"
    role="combobox"
    aria-expanded="false"
    aria-haspopup="listbox"
    aria-controls={`${id}-listbox`}
    aria-labelledby={`${id}-label`}
    disabled
  >
    <span data-select-value>{options[0]?.label}</span><Icon
      name="chevronDown"
    />
  </button>
  <div
    id={`${id}-listbox`}
    class="custom-select-menu"
    role="listbox"
    aria-labelledby={`${id}-label`}
    popover="manual"
    hidden
  >
    {
      options.map((option, index) => (
        <div
          id={`${id}-option-${index}`}
          class="custom-select-option"
          role="option"
          data-value={option.value}
          aria-selected={index === 0 ? "true" : "false"}
        >
          <>
            <span>{option.label}</span>
            <Icon name="check" />
          </>
        </div>
      ))
    }
  </div>
</custom-select>

<script>
  import "../lib/custom-select";
</script>

<style>
  .custom-select {
    display: grid;
    align-content: start;
    gap: 8px;
    min-width: 0;
    max-width: 100%;
  }
  label {
    color: var(--fg-muted);
    font-size: 13px;
  }
  .custom-select-trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    width: 100%;
    min-width: 150px;
    min-height: 44px;
    padding: 10px 12px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--fg);
    font: inherit;
    font-size: 14px;
    text-align: left;
    cursor: pointer;
    transition: border-color 120ms ease;
  }
  .custom-select-trigger:hover,
  .custom-select-trigger[aria-expanded="true"] {
    border-color: var(--accent);
  }
  .custom-select-trigger:disabled {
    cursor: default;
    opacity: 0.65;
  }
  .custom-select-trigger > :global(.icon) {
    flex-shrink: 0;
    width: 16px;
    height: 16px;
    color: var(--fg-muted);
    transition: transform 120ms ease;
  }
  .custom-select-trigger[aria-expanded="true"] > :global(.icon) {
    transform: rotate(180deg);
    color: var(--accent);
  }
  .custom-select-menu {
    position: fixed;
    inset: auto;
    margin: 0;
    padding: 5px;
    box-sizing: border-box;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--fg);
    z-index: 200;
    box-shadow: 0 12px 32px color-mix(in srgb, var(--fg) 12%, transparent);
  }
  .custom-select-menu[hidden] {
    display: none;
  }
  .custom-select-option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    min-height: 44px;
    padding: 10px;
    border-radius: 4px;
    font-size: 14px;
    line-height: 1.4;
    cursor: pointer;
    overflow-wrap: anywhere;
  }
  .custom-select-option[data-active="true"] {
    background: var(--accent-soft);
    color: var(--accent);
    outline: 1px solid var(--accent);
    outline-offset: -1px;
  }
  .custom-select-option[aria-selected="true"] {
    color: var(--accent);
    font-weight: 600;
  }
  .custom-select-option > :global(.icon) {
    flex-shrink: 0;
    width: 16px;
    height: 16px;
    visibility: hidden;
  }
  .custom-select-option[aria-selected="true"] > :global(.icon) {
    visibility: visible;
  }
  @media (max-width: 480px) {
    .custom-select {
      width: 100%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .custom-select-trigger,
    .custom-select-trigger > :global(.icon) {
      transition: none;
    }
  }
  @media (forced-colors: active) {
    .custom-select-option[data-active="true"] {
      outline: 2px solid Highlight;
    }
  }
</style>
