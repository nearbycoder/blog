---
type SearchItem = {
  type: "Page" | "Article" | "Project" | "Theme";
  title: string;
  url: string;
  subtitle?: string;
  keywords?: string;
};

const { items } = Astro.props as { items: SearchItem[] };
const json = JSON.stringify(items).replace(/</g, "\\u003c");
---

<div id="command-palette" class="fixed inset-0 z-50 hidden">
  <div class="absolute inset-0" style="background: color-mix(in srgb, var(--bg) 85%, transparent);" data-overlay></div>
  <div class="relative mx-auto mt-20 w-[min(760px,92vw)]">
    <div class="block-box p-0" style="box-shadow: 10px 10px 0 0 var(--shadow-color);">
      <div class="flex items-center gap-3 rule-b px-5 py-4" style="border-color: var(--border);">
        <span class="label-strong">⌘K /</span>
        <input
          id="command-input"
          type="search"
          placeholder="Search articles, projects, or pages"
          class="w-full bg-transparent font-mono text-base outline-none"
          style="color: var(--fg);"
        />
        <span class="hidden font-mono text-xs uppercase tracking-[0.14em] md:inline" style="color: var(--fg-dim);">ESC</span>
      </div>
      <div class="max-h-[420px] overflow-y-auto p-3">
        <div id="command-results" class="grid gap-3"></div>
      </div>
      <div class="flex flex-wrap items-center justify-between gap-2 rule px-5 py-3 font-mono text-[0.7rem] uppercase tracking-[0.12em]" style="border-color: var(--border); color: var(--fg-muted);">
        <span>↑↓ Navigate</span>
        <span>↵ Open</span>
        <span>ESC Close</span>
      </div>
    </div>
  </div>
  <script id="command-data" type="application/json" set:html={json}></script>
  <script is:inline>
    const palette = document.getElementById("command-palette");
    const overlay = palette?.querySelector("[data-overlay]");
    const input = document.getElementById("command-input");
    const list = document.getElementById("command-results");
    const data = document.getElementById("command-data");
    const root = document.documentElement;
    const STORAGE_KEY = "theme-preference";

    let items = [];
    let activeIndex = 0;
    let currentResults = [];

    const parseData = () => {
      if (!data) return [];
      try {
        return JSON.parse(data.textContent || "[]");
      } catch {
        return [];
      }
    };

    const normalize = (value) => (value || "").toLowerCase();

    const scoreMatch = (query, text) => {
      if (!query) return 1;
      if (!text) return 0;
      const haystack = normalize(text);
      const needle = normalize(query);
      const idx = haystack.indexOf(needle);
      if (idx !== -1) return 200 - idx;

      let score = 0;
      let q = 0;
      for (let i = 0; i < haystack.length && q < needle.length; i += 1) {
        if (haystack[i] === needle[q]) {
          score += 1;
          q += 1;
        }
      }
      if (q < needle.length) return 0;
      return score;
    };

    const buildResults = (query) => {
      const normalized = normalize(query);
      const defaultTypes = new Set(["Page", "Article", "Theme"]);
      const pool = normalized.length === 0
        ? items.filter((item) => defaultTypes.has(item.type))
        : items;
      if (normalized.length === 0) {
        return pool.slice(0, 12);
      }

      const results = pool
        .map((item) => {
          const text = [item.title, item.subtitle, item.keywords, item.type].join(" ");
          return { item, score: scoreMatch(normalized, text) };
        })
        .filter((entry) => entry.score > 0)
        .sort((a, b) => b.score - a.score)
        .slice(0, 12)
        .map((entry) => entry.item);

      return results;
    };

    const setActive = (index) => {
      const nodes = list?.querySelectorAll("[data-index]") || [];
      if (!nodes.length) return;
      activeIndex = Math.max(0, Math.min(index, nodes.length - 1));

      nodes.forEach((node) => {
        const idx = Number(node.getAttribute("data-index"));
        const isActive = idx === activeIndex;
        node.classList.toggle("is-active", isActive);
        if (isActive) {
          node.style.background = "var(--accent)";
          node.style.color = "var(--accent-fg)";
        } else {
          node.style.background = "";
          node.style.color = "";
        }
        node.setAttribute("aria-selected", isActive ? "true" : "false");
      });

      const activeNode = nodes[activeIndex];
      if (activeNode?.scrollIntoView) {
        activeNode.scrollIntoView({ block: "nearest" });
      }
    };

    const renderGroup = (label, entries, registerIndex) => {
      if (!list || entries.length === 0) return;
      const heading = document.createElement("div");
      heading.className = "label-strong";
      heading.style.padding = "0.5rem 0.25rem 0.25rem";
      heading.textContent = label;
      list.appendChild(heading);

      const group = document.createElement("div");
      group.className = "grid gap-1.5";

      entries.forEach((entry) => {
        const link = document.createElement("a");
        link.href = entry.item.url;
        const displayIndex = registerIndex(entry.item);
        link.className = "command-option flex items-center justify-between gap-4 px-3 py-2.5 transition";
        link.style.border = "2px solid var(--border)";
        link.setAttribute("data-index", String(displayIndex));
        link.setAttribute("role", "option");

        const info = document.createElement("div");
        const title = document.createElement("div");
        title.className = "font-mono text-sm font-semibold";
        title.textContent = entry.item.title;

        const subtitle = document.createElement("div");
        subtitle.className = "font-mono text-[0.7rem] uppercase";
        subtitle.style.letterSpacing = "0.12em";
        subtitle.style.opacity = "0.7";
        subtitle.textContent = entry.item.subtitle || entry.item.type;

        info.appendChild(title);
        info.appendChild(subtitle);

        const badge = document.createElement("span");
        badge.className = "font-mono text-[0.68rem] uppercase";
        badge.style.letterSpacing = "0.14em";
        badge.style.opacity = "0.7";
        badge.textContent = entry.item.type;

        link.appendChild(info);
        link.appendChild(badge);
        group.appendChild(link);
      });

      list.appendChild(group);
    };

    const renderResults = (results) => {
      if (!list) return;
      list.innerHTML = "";
      currentResults = [];

      if (!results.length) {
        const empty = document.createElement("div");
        empty.className = "font-mono text-sm";
        empty.style.padding = "1.5rem 0.75rem";
        empty.style.color = "var(--fg-muted)";
        empty.textContent = "No matches. Try a different search.";
        list.appendChild(empty);
        return;
      }

      const grouped = {
        Page: [],
        Article: [],
        Project: [],
        Theme: [],
      };

      results.forEach((item, index) => {
        grouped[item.type]?.push({ item, index });
      });

      const displayResults = [];
      const registerIndex = (item) => {
        displayResults.push(item);
        return displayResults.length - 1;
      };

      renderGroup("Pages", grouped.Page, registerIndex);
      renderGroup("Articles", grouped.Article, registerIndex);
      renderGroup("Projects", grouped.Project, registerIndex);
      renderGroup("Theme", grouped.Theme, registerIndex);

      currentResults = displayResults;
      setActive(0);
    };

    const openPalette = () => {
      if (!palette || !input) return;
      palette.classList.remove("hidden");
      document.body.style.overflow = "hidden";
      input.value = "";
      renderResults(buildResults(""));
      setTimeout(() => input.focus(), 0);
    };

    const closePalette = () => {
      if (!palette) return;
      palette.classList.add("hidden");
      document.body.style.overflow = "";
    };

    const togglePalette = () => {
      if (!palette) return;
      if (palette.classList.contains("hidden")) openPalette();
      else closePalette();
    };

    const handleGlobalKey = (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
        event.preventDefault();
        togglePalette();
        return;
      }

      if (event.key === "Escape" && palette && !palette.classList.contains("hidden")) {
        event.preventDefault();
        closePalette();
      }
    };

    const handleInput = () => {
      if (!input) return;
      renderResults(buildResults(input.value));
    };

    const handleInputKeys = (event) => {
      if (!list) return;
      const max = currentResults.length - 1;

      if (event.key === "ArrowDown") {
        event.preventDefault();
        setActive(Math.min(activeIndex + 1, max));
      }

      if (event.key === "ArrowUp") {
        event.preventDefault();
        setActive(Math.max(activeIndex - 1, 0));
      }

      if (event.key === "Enter" && currentResults[activeIndex]) {
        event.preventDefault();
        handleSelect(currentResults[activeIndex]);
      }
    };

    const handleSelect = (item) => {
      if (!item?.url) return;
      if (item.url.startsWith("theme:")) {
        const value = item.url.split(":")[1] || "system";
        root.setAttribute("data-theme", value);
        try {
          localStorage.setItem(STORAGE_KEY, value);
        } catch {}
        closePalette();
        return;
      }

      window.location.href = item.url;
    };

    const handleClick = (event) => {
      const target = event.target;
      if (target && target.matches("[data-overlay]")) {
        closePalette();
      }
    };

    const handleResultClick = (event) => {
      const target = event.target;
      const entry = target?.closest?.("[data-index]");
      if (!entry) return;
      event.preventDefault();
      const index = Number(entry.getAttribute("data-index"));
      const item = currentResults[index];
      if (item) {
        handleSelect(item);
      }
    };

    const init = () => {
      items = parseData();
      document.addEventListener("keydown", handleGlobalKey);
      input?.addEventListener("input", handleInput);
      input?.addEventListener("keydown", handleInputKeys);
      overlay?.addEventListener("click", handleClick);
      list?.addEventListener("click", handleResultClick);
    };

    init();
  </script>
</div>
