---
import Icon from "./Icon.astro";
type SearchItem = {
  type: string;
  title: string;
  url: string;
  subtitle?: string;
  keywords?: string;
};
const { items } = Astro.props as { items: SearchItem[] };
const json = JSON.stringify(items).replace(/</g, "\\u003c");
---

<dialog id="command-palette" aria-label="Search this site">
  <div class="command-shell">
    <div class="command-search">
      <Icon name="search" /><label for="command-input" class="sr-only"
        >Search articles, projects, pages, and themes</label
      ><input
        id="command-input"
        type="search"
        autocomplete="off"
        placeholder="What are you curious about?"
        role="combobox"
        aria-autocomplete="list"
        aria-expanded="true"
        aria-controls="command-results"
      /><button
        type="button"
        class="btn btn-ghost icon-button"
        data-command-close
        aria-label="Close search"><Icon name="close" /></button
      >
    </div>
    <div
      id="command-results"
      class="command-results"
      role="listbox"
      aria-label="Search results"
    >
    </div>
    <p id="command-status" class="sr-only" role="status"></p>
    <div class="command-footer">
      ↑ ↓ to explore &nbsp; · &nbsp; Enter to open &nbsp; · &nbsp; Esc to close
    </div>
  </div>
</dialog>
<script is:inline id="command-data" type="application/json" set:html={json} />
<script>
  type Item = {
    type: string;
    title: string;
    url: string;
    subtitle?: string;
    keywords?: string;
  };
  const dialog = document.querySelector<HTMLDialogElement>("#command-palette")!;
  const input = document.querySelector<HTMLInputElement>("#command-input")!;
  const list = document.querySelector<HTMLElement>("#command-results")!;
  const status = document.getElementById("command-status")!;
  const items: Item[] = JSON.parse(
    document.getElementById("command-data")?.textContent || "[]",
  );
  let results: Item[] = [];
  let active = 0;
  let previous: HTMLElement | null = null;
  const activate = (index: number) => {
    active = Math.max(0, Math.min(index, results.length - 1));
    list
      .querySelectorAll('[role="option"]')
      .forEach((node, i) =>
        node.setAttribute("aria-selected", String(i === active)),
      );
    if (results.length) {
      input.setAttribute("aria-activedescendant", `command-result-${active}`);
      document
        .getElementById(`command-result-${active}`)
        ?.scrollIntoView({ block: "nearest" });
    } else input.removeAttribute("aria-activedescendant");
  };
  const choose = (item: Item) => {
    if (item.url.startsWith("theme:")) {
      const theme = item.url.slice(6);
      document.documentElement.dataset.theme = theme;
      try {
        localStorage.setItem("theme-preference", theme);
      } catch {}
      document.dispatchEvent(new Event("themechange"));
      dialog.close();
    } else window.location.assign(item.url);
  };
  const render = () => {
    const words = input.value.toLowerCase().trim().split(/\s+/).filter(Boolean);
    results = items
      .filter((item) =>
        words.every((word) =>
          `${item.title} ${item.subtitle ?? ""} ${item.keywords ?? ""} ${item.type}`
            .toLowerCase()
            .includes(word),
        ),
      )
      .slice(0, 30);
    list.replaceChildren();
    status.textContent = `${results.length} results`;
    if (!results.length) {
      const empty = document.createElement("p");
      empty.className = "empty-state";
      empty.textContent = "No matches. Try another title, topic, or project.";
      list.append(empty);
    }
    results.forEach((item, index) => {
      const option = document.createElement("div");
      option.className = "command-option";
      option.id = `command-result-${index}`;
      option.setAttribute("role", "option");
      const info = document.createElement("div");
      const title = document.createElement("span");
      title.textContent = item.title;
      const subtitle = document.createElement("small");
      subtitle.textContent = item.subtitle ?? "";
      info.append(title, subtitle);
      const type = document.createElement("span");
      type.className = "command-type";
      type.textContent = item.type;
      option.append(info, type);
      option.addEventListener("click", () => choose(item));
      option.addEventListener("pointermove", () => activate(index));
      list.append(option);
    });
    activate(0);
  };
  const open = () => {
    if (dialog.open) return;
    previous = document.activeElement as HTMLElement;
    dialog.showModal();
    document.body.style.overflow = "hidden";
    input.value = "";
    render();
    input.focus();
  };
  document
    .querySelectorAll("[data-command-trigger]")
    .forEach((button) => button.addEventListener("click", open));
  dialog
    .querySelector("[data-command-close]")
    ?.addEventListener("click", () => dialog.close());
  dialog.addEventListener("click", (event) => {
    if (event.target === dialog) dialog.close();
  });
  dialog.addEventListener("close", () => {
    document.body.style.overflow = "";
    previous?.focus();
  });
  document.addEventListener("keydown", (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
      event.preventDefault();
      dialog.open ? dialog.close() : open();
    }
  });
  input.addEventListener("input", render);
  input.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      event.preventDefault();
      dialog.close();
      return;
    }
    if (event.key === "ArrowDown" || event.key === "ArrowUp") {
      event.preventDefault();
      activate(active + (event.key === "ArrowDown" ? 1 : -1));
    }
    if (event.key === "Enter" && results[active]) {
      event.preventDefault();
      choose(results[active]);
    }
  });
</script>
