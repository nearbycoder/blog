---
import CustomSelect from "./CustomSelect.astro";
---

<details class="reader-panel" id="reader-preferences">
  <summary>Reading appearance</summary><div class="reader-controls">
    <CustomSelect
      id="reader-size"
      label="Text size"
      options={[
        { value: "17", label: "Standard" },
        { value: "19", label: "Large" },
        { value: "21", label: "Extra large" },
      ]}
    /><CustomSelect
      id="reader-spacing"
      label="Line spacing"
      options={[
        { value: "1.85", label: "Standard" },
        { value: "1.65", label: "Compact" },
        { value: "2.1", label: "Roomy" },
      ]}
    /><CustomSelect
      id="reader-width"
      label="Reading width"
      options={[
        { value: "720", label: "Standard" },
        { value: "600", label: "Narrow" },
        { value: "840", label: "Wide" },
      ]}
    />
  </div><button class="btn" id="reader-reset">Reset appearance</button><p
    class="lab-hint"
    id="reader-preference-status"
    role="status"
  >
    Preferences stay in this browser.
  </p>
</details>
<script>
  import "../lib/custom-select";
  import type { CustomSelectElement } from "../lib/custom-select";
  const key = "nearbycoder:appearance:v1";
  const size = document.querySelector<CustomSelectElement>("#reader-size")!,
    spacing = document.querySelector<CustomSelectElement>("#reader-spacing")!,
    width = document.querySelector<CustomSelectElement>("#reader-width")!,
    status = document.querySelector<HTMLElement>("#reader-preference-status")!;
  const controls = { size, spacing, width };
  function apply() {
    const content = document.querySelector<HTMLElement>(".article-content")!,
      layout = document.querySelector<HTMLElement>(".reading-layout")!;
    content.style.fontSize = size.value + "px";
    content.style.lineHeight = spacing.value;
    layout.style.setProperty("--reading-width", width.value + "px");
  }
  function restore() {
    try {
      const stored = JSON.parse(localStorage.getItem(key) ?? "{}");
      for (const [name, control] of Object.entries(controls)) {
        const candidate = stored?.[name];
        control.value = Array.from(control.options).some(
          (o) => o.value === candidate,
        )
          ? candidate
          : control.options[0].value;
      }
    } catch {
      for (const control of Object.values(controls)) control.selectedIndex = 0;
    }
    apply();
  }
  function save() {
    apply();
    try {
      localStorage.setItem(
        key,
        JSON.stringify({
          size: size.value,
          spacing: spacing.value,
          width: width.value,
        }),
      );
      status.textContent = "Reading appearance saved on this device.";
    } catch {
      status.textContent =
        "Appearance applied for this page. Browser storage is unavailable.";
    }
  }
  for (const control of Object.values(controls))
    control.addEventListener("change", save);
  document.querySelector("#reader-reset")!.addEventListener("click", () => {
    for (const control of Object.values(controls)) control.selectedIndex = 0;
    save();
  });
  window.addEventListener("storage", (event) => {
    if (event.key === key || event.key === null) restore();
  });
  restore();
</script>
