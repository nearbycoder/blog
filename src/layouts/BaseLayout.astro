---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import CommandPalette from "../components/CommandPalette.astro";
import { site } from "../data/site";
import { getCollection } from "astro:content";

const { title, description, handle } = site;
const pageTitle = Astro.props.title ? `${Astro.props.title} · ${title}` : title;
const pageDescription = Astro.props.description ?? description;
const ogType = Astro.props.type ?? "website";
const imagePath = Astro.props.image ?? "/og/site.svg";
const imageAlt = Astro.props.imageAlt ?? pageTitle;
const siteUrl = Astro.site ?? new URL("https://nearbycoder.com");
const canonicalUrl = Astro.url?.toString() ?? new URL("/", siteUrl).toString();
const ogImageUrl = new URL(imagePath, siteUrl).toString();
const twitterHandle = handle ? `@${handle}` : undefined;

const articles = ((await getCollection("articles")) as any[]).sort((a: any, b: any) =>
  b.data.date.localeCompare(a.data.date)
);
const projects = (await getCollection("projects")) as any[];

const searchItems = [
  { type: "Page", title: "Home", url: "/", subtitle: "Navigation" },
  ...site.nav.map((item) => ({
    type: "Page",
    title: item.label,
    url: item.href,
    subtitle: "Navigation",
  })),
  {
    type: "Theme",
    title: "Light mode",
    url: "theme:light",
    subtitle: "Appearance",
    keywords: "theme appearance light mode",
  },
  {
    type: "Theme",
    title: "Dark mode",
    url: "theme:dark",
    subtitle: "Appearance",
    keywords: "theme appearance dark mode",
  },
  {
    type: "Theme",
    title: "System theme",
    url: "theme:system",
    subtitle: "Appearance",
    keywords: "theme appearance system mode",
  },
  ...articles
    .filter((entry) => !entry.data.draft)
    .map((entry) => ({
      type: "Article",
      title: entry.data.title,
      url: `/articles/${entry.slug}`,
      subtitle: [entry.data.date, entry.data.readTime].filter(Boolean).join(" · "),
      keywords: [entry.data.description, ...(entry.data.tags ?? [])].join(" "),
    })),
  ...projects
    .filter((entry) => !entry.data.draft)
    .map((entry) => ({
      type: "Project",
      title: entry.data.title,
      url: `/projects/${entry.slug}`,
      subtitle: [entry.data.year, entry.data.role].filter(Boolean).join(" · "),
      keywords: [entry.data.summary, ...(entry.data.stack ?? [])].join(" "),
    })),
];
---

<!doctype html>
<html lang="en" data-theme="system">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem("theme-preference");
          const theme =
            stored === "light" || stored === "dark" || stored === "system" ? stored : "system";
          document.documentElement.setAttribute("data-theme", theme);
        } catch {}
      })();
    </script>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:site_name" content={title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    {twitterHandle && <meta name="twitter:site" content={twitterHandle} />}
    {twitterHandle && <meta name="twitter:creator" content={twitterHandle} />}
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Space+Grotesk:wght@300;400;500;600;700&display=swap"
    />
    <link rel="icon" type="image/jpeg" href="/logo.jpeg" />
    <script defer data-domain="nearbycoder.com" src="https://tic.nrby.xyz/js/script.js"></script>
    <title>{pageTitle}</title>
  </head>
  <body class="bg-grid min-h-screen flex flex-col">
    <div class="pointer-events-none fixed inset-0 page-glow opacity-70"></div>
    <SiteHeader />
    <main class="relative z-10 mx-auto w-full max-w-6xl flex-1 px-6 pb-24">
      <slot />
    </main>
    <SiteFooter />
    <CommandPalette items={searchItems} />
  </body>
</html>
