---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { site } from "../data/site";

const { title, description, handle } = site;
const pageTitle = Astro.props.title ? `${Astro.props.title} · ${title}` : title;
const pageDescription = Astro.props.description ?? description;
const ogType = Astro.props.type ?? "website";
const imagePath = Astro.props.image ?? "/og/site.svg";
const imageAlt = Astro.props.imageAlt ?? pageTitle;
const siteUrl = Astro.site ?? new URL("https://nearbycoder.com");
const canonicalUrl = Astro.url?.toString() ?? new URL("/", siteUrl).toString();
const ogImageUrl = new URL(imagePath, siteUrl).toString();
const twitterHandle = handle ? `@${handle}` : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:site_name" content={title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    {twitterHandle && <meta name="twitter:site" content={twitterHandle} />}
    {twitterHandle && <meta name="twitter:creator" content={twitterHandle} />}
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Space+Grotesk:wght@300;400;500;600;700&display=swap"
    />
    <link rel="icon" type="image/jpeg" href="/logo.jpeg" />
    <script defer data-domain="nearbycoder.com" src="https://tic.nrby.xyz/js/script.js"></script>
    <title>{pageTitle}</title>
  </head>
  <body class="bg-grid text-white min-h-screen flex flex-col">
    <div class="pointer-events-none fixed inset-0 bg-[radial-gradient(circle_at_top_left,rgba(255,255,255,0.08),transparent_45%),radial-gradient(circle_at_70%_10%,rgba(111,209,215,0.16),transparent_50%),radial-gradient(circle_at_90%_90%,rgba(245,181,74,0.16),transparent_60%)] opacity-70"></div>
    <SiteHeader />
    <main class="relative z-10 mx-auto w-full max-w-6xl flex-1 px-6 pb-24">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
