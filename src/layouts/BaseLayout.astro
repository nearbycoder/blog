---
import "../styles/global.css";
import {getReadingPaths} from "../lib/discovery";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import CommandPalette from "../components/CommandPalette.astro";
import { site } from "../data/site";
import { getCollection } from "astro:content";
import {
  compareArticlesByPublishDateDesc,
  isArticlePublished,
} from "../lib/articles";
import { getImagePath } from "astro-opengraph-images";

const { title, description, handle } = site;
const pageTitle = Astro.props.title
  ? `${Astro.props.title} · Josh Hamilton`
  : "Josh Hamilton · Nearbycoder";
const pageDescription = Astro.props.description ?? description;
const ogType = Astro.props.type ?? "website";
const imageAlt = Astro.props.imageAlt ?? pageTitle;
const siteUrl = Astro.site ?? new URL("https://nearbycoder.com");
const currentUrl = Astro.url ?? new URL("/", siteUrl);
const canonicalUrl = new URL(currentUrl.pathname, siteUrl).toString();
const rssUrl = new URL("/rss.xml", siteUrl).toString();
const ogImageUrl = getImagePath({ url: currentUrl, site: Astro.site });
const twitterHandle = handle ? `@${handle}` : undefined;
const includeScheduled = !import.meta.env.PROD;

const articles = ((await getCollection("articles")) as any[]).sort(
  (a: any, b: any) => compareArticlesByPublishDateDesc(a, b),
);
const projects = (await getCollection("projects")) as any[];
const layoffEntries = (await getCollection("layoff")) as any[];

const readingPaths=await getReadingPaths();
const postmortems=(await getCollection("postmortems")).filter(e=>!e.data.draft);
const searchItems = [
  ...readingPaths.map(path=>({type:"Reading path",title:path.title,url:`/start-here/${path.slug}`,subtitle:`${path.entries.length} stories`,keywords:path.description})),
  ...postmortems.map(entry=>({type:"Postmortem",title:entry.data.title,url:`/postmortems/${entry.id}`,subtitle:entry.data.date,keywords:entry.data.description})),
  { type: "Page", title: "Home", url: "/", subtitle: "Navigation" },
  ...[...site.nav,...site.explore].map((item) => ({
    type: "Page",
    title: item.label,
    url: item.href,
    subtitle: "Navigation",
  })),
  {
    type: "Theme",
    title: "Light mode",
    url: "theme:light",
    subtitle: "Appearance",
    keywords: "theme appearance light mode",
  },
  {
    type: "Theme",
    title: "Dark mode",
    url: "theme:dark",
    subtitle: "Appearance",
    keywords: "theme appearance dark mode",
  },
  {
    type: "Theme",
    title: "System theme",
    url: "theme:system",
    subtitle: "Appearance",
    keywords: "theme appearance system mode",
  },
  ...articles
    .filter((entry) => isArticlePublished(entry, { includeScheduled }))
    .map((entry) => ({
      type: "Article",
      title: entry.data.title,
      url: `/articles/${entry.id}`,
      subtitle: [entry.data.date, entry.data.readTime]
        .filter(Boolean)
        .join(" · "),
      keywords: [entry.data.description, ...(entry.data.tags ?? [])].join(" "),
    })),
  ...projects
    .filter((entry) => !entry.data.draft)
    .map((entry) => ({
      type: "Project",
      title: entry.data.title,
      url: `/projects/${entry.id}`,
      subtitle: [entry.data.year, entry.data.role].filter(Boolean).join(" · "),
      keywords: [entry.data.summary, ...(entry.data.stack ?? [])].join(" "),
    })),
  ...layoffEntries
    .filter((entry) => !entry.data.draft)
    .map((entry) => ({
      type: "Layoff Build",
      title: entry.data.title,
      url: `/layoff/${entry.id}`,
      subtitle: [
        entry.data.date,
        entry.data.week
          ? `Week ${entry.data.week}`
          : entry.data.day
            ? `Day ${entry.data.day}`
            : null,
        entry.data.status,
      ]
        .filter(Boolean)
        .join(" · "),
      keywords: [entry.data.summary, ...(entry.data.stack ?? [])].join(" "),
    })),
];
---

<!doctype html>
<html lang="en" data-theme="system">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem("theme-preference");
          const theme =
            stored === "light" || stored === "dark" || stored === "system"
              ? stored
              : "system";
          document.documentElement.setAttribute("data-theme", theme);
        } catch {}
      })();
    </script>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.name} RSS Feed`}
      href={rssUrl}
    />
    <meta property="og:site_name" content={title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    {twitterHandle && <meta name="twitter:site" content={twitterHandle} />}
    {twitterHandle && <meta name="twitter:creator" content={twitterHandle} />}
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <link rel="icon" type="image/jpeg" href="/logo.jpeg" />
    <script
      is:inline
      defer
      data-domain="nearbycoder.com"
      src="https://tic.nrby.xyz/js/script.js"></script>
    <title>{pageTitle}</title>
  </head>
  <body class="flex flex-col">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SiteHeader />
    <main id="main-content" class="site-container site-main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
    <CommandPalette items={searchItems} />
  </body>
</html>
