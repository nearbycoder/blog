---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import CommandPalette from "../components/CommandPalette.astro";
import { site } from "../data/site";
import { getCollection } from "astro:content";
import { compareArticlesByPublishDateDesc, isArticlePublished } from "../lib/articles";
import { getImagePath } from "astro-opengraph-images";

const { title, description, handle } = site;
const pageTitle = Astro.props.title ? `${Astro.props.title} · ${title}` : title;
const pageDescription = Astro.props.description ?? description;
const ogType = Astro.props.type ?? "website";
const imageAlt = Astro.props.imageAlt ?? pageTitle;
const siteUrl = Astro.site ?? new URL("https://nearbycoder.com");
const currentUrl = Astro.url ?? new URL("/", siteUrl);
const canonicalUrl = currentUrl.toString();
const rssUrl = new URL("/rss.xml", siteUrl).toString();
const ogImageUrl = getImagePath({ url: currentUrl, site: Astro.site });
const twitterHandle = handle ? `@${handle}` : undefined;
const includeScheduled = !import.meta.env.PROD;

const articles = ((await getCollection("articles")) as any[]).sort((a: any, b: any) =>
  compareArticlesByPublishDateDesc(a, b)
);
const projects = (await getCollection("projects")) as any[];
const layoffEntries = (await getCollection("layoff")) as any[];

const searchItems = [
  { type: "Page", title: "Home", url: "/", subtitle: "Navigation" },
  ...site.nav.map((item) => ({
    type: "Page",
    title: item.label,
    url: item.href,
    subtitle: "Navigation",
  })),
  {
    type: "Theme",
    title: "Light mode",
    url: "theme:light",
    subtitle: "Appearance",
    keywords: "theme appearance light mode",
  },
  {
    type: "Theme",
    title: "Dark mode",
    url: "theme:dark",
    subtitle: "Appearance",
    keywords: "theme appearance dark mode",
  },
  {
    type: "Theme",
    title: "System theme",
    url: "theme:system",
    subtitle: "Appearance",
    keywords: "theme appearance system mode",
  },
  ...articles
    .filter((entry) => isArticlePublished(entry, { includeScheduled }))
    .map((entry) => ({
      type: "Article",
      title: entry.data.title,
      url: `/articles/${entry.id}`,
      subtitle: [entry.data.date, entry.data.readTime].filter(Boolean).join(" · "),
      keywords: [entry.data.description, ...(entry.data.tags ?? [])].join(" "),
    })),
  ...projects
    .filter((entry) => !entry.data.draft)
    .map((entry) => ({
      type: "Project",
      title: entry.data.title,
      url: `/projects/${entry.id}`,
      subtitle: [entry.data.year, entry.data.role].filter(Boolean).join(" · "),
      keywords: [entry.data.summary, ...(entry.data.stack ?? [])].join(" "),
    })),
  ...layoffEntries
    .filter((entry) => !entry.data.draft)
    .map((entry) => ({
      type: "Layoff Build",
      title: entry.data.title,
      url: `/layoff/${entry.id}`,
      subtitle: [
        entry.data.date,
        entry.data.week ? `Week ${entry.data.week}` : entry.data.day ? `Day ${entry.data.day}` : null,
        entry.data.status,
      ]
        .filter(Boolean)
        .join(" · "),
      keywords: [entry.data.summary, ...(entry.data.stack ?? [])].join(" "),
    })),
];
---

<!doctype html>
<html lang="en" data-theme="system">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem("theme-preference");
          const theme =
            stored === "light" || stored === "dark" || stored === "system" ? stored : "system";
          document.documentElement.setAttribute("data-theme", theme);
        } catch {}
      })();
    </script>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} RSS Feed`} href={rssUrl} />
    <meta property="og:site_name" content={title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    {twitterHandle && <meta name="twitter:site" content={twitterHandle} />}
    {twitterHandle && <meta name="twitter:creator" content={twitterHandle} />}
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <link rel="icon" type="image/jpeg" href="/logo.jpeg" />
    <script defer data-domain="nearbycoder.com" src="https://tic.nrby.xyz/js/script.js"></script>
    <title>{pageTitle}</title>
  </head>
  <body class="min-h-screen flex flex-col">
    <SiteHeader />
    <main class="relative mx-auto w-full max-w-[1240px] flex-1 px-5 pb-24 sm:px-8">
      <slot />
    </main>
    <SiteFooter />
    <CommandPalette items={searchItems} />
  </body>
</html>
