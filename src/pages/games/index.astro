---
import BlogLayout from "../../layouts/BlogLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { getCollection } from "astro:content";
import { compareWorkByDate } from "../../lib/work";

const games = (await getCollection("games"))
  .filter((entry) => !entry.data.draft)
  .sort(compareWorkByDate);
---

<BlogLayout
  title="Games"
  description="Games Josh Hamilton has built: browser arcade games, physics toys, Unity puzzle games, and Rust roguelites, each with how it was made."
>
  <section class="page-shell space-y-8">
    <header class="page-intro">
      <p class="paper-strip">Games / {games.length} builds</p>
      <h1 class="display">Made to be<br /><em>played.</em></h1>
      <p style="color:var(--fg-muted)">
        Browser toys, cozy puzzle games, and the occasional gothic shooter,
        newest first. Every game has its own page covering how it plays, what it
        was built with, and how it was made.
      </p>
    </header>

    <a class="text-link" href="/projects">Looking for projects? →</a>
    <div class="project-grid">
      {
        games.map((game, index) => (
          <ProjectCard project={game} index={index} heading="h2" />
        ))
      }
    </div>
  </section>
</BlogLayout>
