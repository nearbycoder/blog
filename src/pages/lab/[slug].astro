---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { labs } from "../../data/labs";
import Roomba from "../../components/lab/Roomba.astro";
import Poll from "../../components/lab/Poll.astro";
import Agent from "../../components/lab/Agent.astro";
import { getEntry } from "astro:content";
export function getStaticPaths() {
  return labs.map((lab) => ({ params: { slug: lab.slug }, props: { lab } }));
}
const { lab } = Astro.props;
const project = await getEntry("projects", lab.project);
---

<BaseLayout title={lab.title} description={lab.description}>
  <header class="page-intro">
    <a class="nav-link" href="/lab">← All experiments</a><h1 class="display">
      {lab.title}
    </h1><p class="deck">{lab.description}</p>
  </header>
  {
    lab.slug === "roomba" ? (
      <Roomba />
    ) : lab.slug === "poll" ? (
      <Poll />
    ) : (
      <Agent />
    )
  }
  <noscript
    ><p class="lab-status">
      These experiments need JavaScript. You can still read the project story
      below.
    </p></noscript
  >
  <section class="lab-source">
    <h2>The project behind the experiment</h2><p>{project!.data.summary}</p><a
      class="text-link"
      href={`/projects/${lab.project}`}>Explore {project!.data.title} →</a>
  </section>
</BaseLayout>
