---
import { technologySlug } from "../../lib/technologies";
import { labs } from "../../data/labs";
import ProjectStory from "../../components/ProjectStory.astro";
import BlogLayout from "../../layouts/BlogLayout.astro";
import Icon from "../../components/Icon.astro";
import { getCollection, render } from "astro:content";
import { formatDate, projectImage, projectImageAlt } from "../../lib/media";
export async function getStaticPaths() {
  return (await getCollection("projects"))
    .filter((entry) => !entry.data.draft)
    .map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const image = projectImage(entry);
const lab = labs.find((lab) => lab.project === entry.id);
---

<BlogLayout title={entry.data.title} description={entry.data.summary}>
  <article>
    <header class="reading-header">
      <a href="/projects" class="nav-link">← All projects</a><h1
        class="display"
      >
        {entry.data.title}
      </h1><p class="deck">{entry.data.summary}</p><div
        class="mt-7 flex flex-wrap gap-3"
      >
        {
          entry.data.link && (
            <a
              href={entry.data.link}
              class="btn btn-accent"
              target="_blank"
              rel="noreferrer"
            >
              Visit project <Icon name="external" />
            </a>
          )
        }{
          entry.data.githubLink && (
            <a
              href={entry.data.githubLink}
              class="btn"
              target="_blank"
              rel="noreferrer"
            >
              View source <Icon name="external" />
            </a>
          )
        }
      </div>
    </header>
    {
      image && (
        <figure class="reading-cover">
          <img
            src={image}
            alt={projectImageAlt(entry)}
            width="1200"
            height="600"
            fetchpriority="high"
            style="object-fit:contain"
          />
          {entry.data.imageCaption && (
            <figcaption>{entry.data.imageCaption}</figcaption>
          )}
        </figure>
      )
    }
    <div class="reading-layout">
      <aside class="reading-sidebar">
        <p class="label">Project details</p><p class="mt-4 text-sm">
          {entry.data.role}
        </p>{
          entry.data.createdAt ? (
            <p class="project-created mt-4">
              <span class="label">Repository created</span>
              <time
                datetime={entry.data.createdAt}
                title="GitHub repository creation date (UTC)"
              >
                {formatDate(entry.data.createdAt)}
              </time>
            </p>
          ) : (
            <p class="label mt-2">{entry.data.year}</p>
          )
        }<div class="mt-6 flex flex-wrap gap-2">
          {
            entry.data.stack.map((item) => (
              <a class="chip" href={`/technologies/${technologySlug(item)}/`}>
                {item}
              </a>
            ))
          }
        </div>
      </aside><div>
        {
          entry.data.impact && (
            <div
              class="mb-8 border-l-2 pl-6"
              style="border-color:var(--accent)"
            >
              <>
                <p class="label mb-3">The outcome</p>
                <p class="text-xl leading-relaxed">{entry.data.impact}</p>
              </>
            </div>
          )
        }<div class="article-content"><Content /></div>
        {
          entry.data.demoVideos.length > 0 && (
            <section
              class="project-demos"
              aria-labelledby="project-demos-heading"
            >
              <h2 id="project-demos-heading">See it in action</h2>
              {entry.data.demoVideos.map((demo, index) => (
                <figure>
                  <h3>{demo.title}</h3>
                  <video
                    src={demo.src}
                    poster={demo.poster}
                    controls
                    preload="none"
                    playsinline
                    aria-label={demo.title}
                    aria-describedby={`project-demo-caption-${index}`}
                  >
                    <a href={demo.src}>Watch {demo.title}</a>
                  </video>
                  <figcaption id={`project-demo-caption-${index}`}>
                    {demo.caption}
                  </figcaption>
                </figure>
              ))}
            </section>
          )
        }
        <div class="reading-end">
          <a href="/projects" class="text-link"
            >Explore more projects <Icon name="arrow" /></a
          >
        </div>
      </div>
    </div>
  </article>
  {
    lab && (
      <section class="lab-source">
        <>
          <h2>Try a piece of this project</h2>
          <p>{lab.description}</p>
          <a href={`/lab/${lab.slug}`} class="text-link">
            {lab.title} →
          </a>
        </>
      </section>
    )
  }
  <ProjectStory projectId={entry.id} />
</BlogLayout>

<style>
  .reading-cover figcaption,
  .project-demos figcaption {
    margin-top: 12px;
    color: var(--fg-muted);
    font-size: 0.875rem;
    line-height: 1.6;
  }
  .reading-cover figcaption {
    padding: 0 8px 8px;
  }
  .project-created time {
    display: block;
    margin-top: 4px;
    font-size: 0.875rem;
  }
  .project-demos {
    margin-top: 48px;
  }
  .project-demos h2 {
    font-family: var(--font-display);
    font-size: 2rem;
    line-height: 1.2;
  }
  .project-demos figure {
    margin-top: 28px;
  }
  .project-demos h3 {
    margin-bottom: 12px;
    font-size: 1.125rem;
  }
  .project-demos video {
    display: block;
    width: 100%;
    height: auto;
    max-height: 600px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
</style>
