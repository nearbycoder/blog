---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const entries = (await getCollection("projects")) as any[];
  return entries.filter((entry: any) => !entry.data.draft).map((entry: any) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props as { entry: any };
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title}>
  <article class="mx-auto mt-10 max-w-3xl space-y-10">
    <header class="rule-b-heavy pb-6 space-y-4" style="border-color: var(--border);">
      <div class="flex items-center gap-3">
        <a href="/projects" class="nav-link">← Projects</a>
        <span class="dot dot-accent"></span>
        <span class="font-mono text-xs uppercase tracking-[0.14em]" style="color: var(--fg-muted);">
          {entry.data.year} · {entry.data.role}
        </span>
      </div>
      <h1 class="display text-4xl md:text-6xl">{entry.data.title}</h1>
      <p class="text-lg leading-relaxed" style="color: var(--fg-muted);">{entry.data.summary}</p>
      {entry.data.link || entry.data.githubLink ? (
        <div class="flex flex-wrap gap-2">
          {entry.data.link ? (
            <a href={entry.data.link} target="_blank" rel="noreferrer" class="btn btn-accent">
              Visit project ↗
            </a>
          ) : null}
          {entry.data.githubLink ? (
            <a href={entry.data.githubLink} target="_blank" rel="noreferrer" class="btn">
              View code ↗
            </a>
          ) : null}
        </div>
      ) : null}
    </header>

    {entry.data.stack?.length ? (
      <div class="flex flex-wrap gap-1.5">
        {entry.data.stack.map((item: string) => (
          <span class="chip">{item}</span>
        ))}
      </div>
    ) : null}

    {entry.data.impact ? (
      <div class="block-box block-box-shadow p-6">
        <p class="label-strong">Impact</p>
        <p class="mt-3 display text-xl md:text-2xl">{entry.data.impact}</p>
      </div>
    ) : null}

    <div class="article-content">
      <Content />
    </div>
  </article>
</BaseLayout>
