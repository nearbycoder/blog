---
import { technologySlug } from "../../lib/technologies";
import { labs } from "../../data/labs";
import ProjectStory from "../../components/ProjectStory.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import { getCollection, render } from "astro:content";
import { projectImage } from "../../lib/media";
export async function getStaticPaths() {
  return (await getCollection("projects"))
    .filter((entry) => !entry.data.draft)
    .map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const image = projectImage(entry);
const lab = labs.find((lab) => lab.project === entry.id);
---

<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <article>
    <header class="reading-header">
      <a href="/projects" class="nav-link">← All projects</a><h1
        class="display"
      >
        {entry.data.title}
      </h1><p class="deck">{entry.data.summary}</p><div
        class="mt-7 flex flex-wrap gap-3"
      >
        {
          entry.data.link && (
            <a
              href={entry.data.link}
              class="btn btn-accent"
              target="_blank"
              rel="noreferrer"
            >
              Visit project <Icon name="external" />
            </a>
          )
        }{
          entry.data.githubLink && (
            <a
              href={entry.data.githubLink}
              class="btn"
              target="_blank"
              rel="noreferrer"
            >
              View source <Icon name="external" />
            </a>
          )
        }
      </div>
    </header>
    {
      image && (
        <div class="reading-cover">
          <img
            src={image}
            alt={`${entry.data.title} project screenshot`}
            width="1200"
            height="600"
            fetchpriority="high"
            style="object-fit:contain"
          />
        </div>
      )
    }
    <div class="reading-layout">
      <aside class="reading-sidebar">
        <p class="label">Project details</p><p class="mt-4 text-sm">
          {entry.data.role}
        </p><p class="label mt-2">{entry.data.year}</p><div
          class="mt-6 flex flex-wrap gap-2"
        >
          {
            entry.data.stack.map((item) => (
              <a class="chip" href={`/technologies/${technologySlug(item)}/`}>
                {item}
              </a>
            ))
          }
        </div>
      </aside><div>
        {
          entry.data.impact && (
            <div
              class="mb-8 border-l-2 pl-6"
              style="border-color:var(--accent)"
            >
              <>
                <p class="label mb-3">The outcome</p>
                <p class="text-xl leading-relaxed">{entry.data.impact}</p>
              </>
            </div>
          )
        }<div class="article-content"><Content /></div><div class="reading-end">
          <a href="/projects" class="text-link"
            >Explore more projects <Icon name="arrow" /></a
          >
        </div>
      </div>
    </div>
  </article>
  {
    lab && (
      <section class="lab-source">
        <>
          <h2>Try a piece of this project</h2>
          <p>{lab.description}</p>
          <a href={`/lab/${lab.slug}`} class="text-link">
            {lab.title} →
          </a>
        </>
      </section>
    )
  }
  <ProjectStory projectId={entry.id} />
</BaseLayout>
