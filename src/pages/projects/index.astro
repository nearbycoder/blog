---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects")) as any[];
const bottomProjectSlug = "easyaccessqr-com";
const sortedProjects = projects
  .filter((entry: any) => !entry.data.draft)
  .sort((a: any, b: any) => {
    const aIsBottom = a.id === bottomProjectSlug;
    const bIsBottom = b.id === bottomProjectSlug;

    if (aIsBottom && !bIsBottom) return 1;
    if (!aIsBottom && bIsBottom) return -1;

    return b.data.year.localeCompare(a.data.year);
  });
---

<BaseLayout title="Projects">
  <section class="mt-12 space-y-8">
    <header class="rule-b-heavy pb-6 space-y-3" style="border-color: var(--border);">
      <p class="label-strong">§ Projects / {sortedProjects.length} builds</p>
      <h1 class="display text-5xl md:text-6xl">
        Systems, tools <span class="marker">&amp;</span><br />
        product execution.
      </h1>
      <p class="max-w-2xl text-base leading-relaxed" style="color: var(--fg-muted);">
        A selection of platforms and features focused on reliability, clarity, and operator confidence.
      </p>
    </header>

    <div class="grid gap-6 md:grid-cols-2">
      {sortedProjects.map((project: any, index: number) => (
        <ProjectCard project={project} index={index} />
      ))}
    </div>
  </section>
</BaseLayout>
