---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects")) as any[];
const bottomProjectSlug = "easyaccessqr-com";
const sortedProjects = projects
  .filter((entry: any) => !entry.data.draft)
  .sort((a: any, b: any) => {
    const aIsBottom = a.id === bottomProjectSlug;
    const bIsBottom = b.id === bottomProjectSlug;

    if (aIsBottom && !bIsBottom) return 1;
    if (!aIsBottom && bIsBottom) return -1;

    return b.data.year.localeCompare(a.data.year);
  });
---

<BaseLayout title="Projects">
  <section class="page-shell space-y-8">
    <header class="page-intro">
      <p class="paper-strip">Projects / {sortedProjects.length} builds</p>
      <h1 class="display">Less talking.<br /><em>More making.</em></h1>
      <p style="color:var(--fg-muted)">
        Side projects, useful tools, and ideas that made it out of the notes
        app. Built to learn, built to use, built to share.
      </p>
    </header>

    <a class="text-link" href="/technologies/"
      >Explore projects by technology →</a
    >
    <div class="project-grid">
      {
        sortedProjects.map((project: any, index: number) => (
          <ProjectCard project={project} index={index} heading="h2" />
        ))
      }
    </div>
  </section>
</BaseLayout>
