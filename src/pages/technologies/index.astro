---
import BlogLayout from "../../layouts/BlogLayout.astro";
import {
  describeTechnologyCount,
  getTechnologies,
} from "../../lib/technologies";
const technologies = await getTechnologies();
---

<BlogLayout
  title="Project technologies"
  description="Explore the tools and technologies declared in published projects and games."
  ><section class="page-shell">
    <header class="page-intro">
      <p class="label">Under the hood</p><h1 class="display">
        The tools<br />behind the builds.
      </h1><p>
        Explore projects and games by their declared stack. Versions and names
        follow the original project notes.
      </p>
    </header><ul class="topic-directory">
      {
        technologies.map((tech) => (
          <li>
            <a href={`/technologies/${tech.slug}/`}>
              <>
                <span>{tech.name}</span>
                <span class="label">{describeTechnologyCount(tech)} →</span>
              </>
            </a>
          </li>
        ))
      }
    </ul>
  </section></BlogLayout
>
