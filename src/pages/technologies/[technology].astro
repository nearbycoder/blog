---
import BlogLayout from "../../layouts/BlogLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import {
  describeTechnologyCount,
  getTechnologies,
} from "../../lib/technologies";
export async function getStaticPaths() {
  return (await getTechnologies()).map((technology) => ({
    params: { technology: technology.slug },
    props: { technology },
  }));
}
const { technology } = Astro.props;
---

<BlogLayout
  title={`${technology.name} projects`}
  description={`Published projects and games built with ${technology.name}.`}
  ><section class="page-shell">
    <header class="page-intro">
      <a class="text-link" href="/technologies/">← All technologies</a><h1
        class="display"
      >
        {technology.name}
      </h1><p>
        {describeTechnologyCount(technology)} using this technology, based on the
        original build notes.
      </p>
    </header>{
      technology.projects.length > 0 && (
        <div class="project-grid">
          {technology.projects.map((project, index) => (
            <ProjectCard project={project} index={index} heading="h2" />
          ))}
        </div>
      )
    }{
      technology.games.length > 0 && (
        <section class="technology-games" aria-labelledby="technology-games">
          <header class="section-head">
            <h2 id="technology-games">Games</h2>
            <a class="text-link" href="/games">
              All games →
            </a>
          </header>
          <div class="project-grid">
            {technology.games.map((game, index) => (
              <ProjectCard project={game} index={index} heading="h3" />
            ))}
          </div>
        </section>
      )
    }
  </section></BlogLayout
>

<style>
  .technology-games {
    margin-top: 72px;
  }
  .technology-games .section-head {
    margin-bottom: 32px;
  }
</style>
