---
import BaseLayout from "../layouts/BaseLayout.astro";
import { uses } from "../data/uses";

const data = uses as unknown as {
  workstation: { name: string; description: string; url?: string }[];
  development: { name: string; description: string; url?: string }[];
  productivity: { name: string; description: string; url?: string }[];
  ai: { name: string; description: string; url?: string }[];
};

const sections: { key: string; label: string; items: { name: string; description: string; url?: string }[] }[] = [
  { key: "workstation", label: "Workstation", items: data.workstation },
  { key: "development", label: "Development", items: data.development },
  { key: "productivity", label: "Productivity", items: data.productivity },
  { key: "ai", label: "AI Tools", items: data.ai },
];
---

<BaseLayout title="Uses">
  <section class="mt-12 space-y-10">
    <header class="rule-b-heavy pb-6 space-y-3" style="border-color: var(--border);">
      <p class="label-strong">§ Uses / Gear &amp; Tools</p>
      <h1 class="display text-5xl md:text-6xl">
        Software, gadgets<br />
        &amp; <span class="marker">other things</span><br />
        I recommend.
      </h1>
      <p class="max-w-2xl text-base leading-relaxed" style="color: var(--fg-muted);">
        I get asked a lot about the things I use to build software, stay productive, or buy to fool myself
        into thinking I'm being productive when I'm really just procrastinating.
      </p>
    </header>

    <div class="grid gap-8">
      {sections.map((section, sectionIndex) => (
        <section class="block-box block-box-shadow">
          <header class="flex items-center justify-between gap-3 rule-b px-5 py-3" style="border-color: var(--border);">
            <p class="label-strong">§ {String(sectionIndex + 1).padStart(2, "0")} / {section.label}</p>
            <span class="font-mono text-xs uppercase tracking-[0.14em]" style="color: var(--fg-muted);">
              {section.items.length} items
            </span>
          </header>
          <ul class="divide-y" style="border-color: var(--border);">
            {section.items.map((item, itemIndex) => (
              <li
                class="grid gap-2 px-5 py-4 md:grid-cols-[minmax(0,14rem)_1fr] md:gap-6"
                style={itemIndex === 0 ? undefined : "border-top: 2px solid var(--border);"}
              >
                <div>
                  {item.url ? (
                    <a
                      href={item.url}
                      target="_blank"
                      rel="noreferrer"
                      class="display text-lg md:text-xl transition hover:underline"
                      style="text-decoration-color: var(--accent); text-decoration-thickness: 3px; text-underline-offset: 4px;"
                    >
                      {item.name} ↗
                    </a>
                  ) : (
                    <span class="display text-lg md:text-xl">{item.name}</span>
                  )}
                </div>
                <p class="text-sm leading-relaxed" style="color: var(--fg-muted);">{item.description}</p>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </section>
</BaseLayout>
