---
import BaseLayout from "../layouts/BaseLayout.astro";
import { uses } from "../data/uses";

const data = uses as unknown as {
  workstation: { name: string; description: string; url?: string }[];
  development: { name: string; description: string; url?: string }[];
  productivity: { name: string; description: string; url?: string }[];
  ai: { name: string; description: string; url?: string }[];
};

const sections: {
  key: string;
  label: string;
  items: { name: string; description: string; url?: string }[];
}[] = [
  { key: "workstation", label: "Workstation", items: data.workstation },
  { key: "development", label: "Development", items: data.development },
  { key: "productivity", label: "Productivity", items: data.productivity },
  { key: "ai", label: "AI Tools", items: data.ai },
];
---

<BaseLayout
  title="Uses"
  description="The hardware, software, and everyday tools Josh Hamilton uses to build software."
>
  <section class="page-shell space-y-10">
    <header class="page-intro">
      <p class="paper-strip">Uses · Gear &amp; tools</p><h1 class="display">
        Behind the screen.<br /><em>Inside the toolkit.</em>
      </h1><p style="color:var(--fg-muted)">
        The things I use to make things. Some are essential. Some just make the
        day a little better.
      </p>
    </header>
    <div class="uses-layout">
      <nav class="uses-nav" aria-label="Tool categories">
        {
          sections.map((section) => (
            <a href={`#${section.key}`} class="nav-link">
              {section.label}
            </a>
          ))
        }
      </nav><div>
        {
          sections.map((section) => (
            <section class="uses-section" id={section.key}>
              <>
                <h2>{section.label}</h2>
                <ul class="uses-items">
                  {section.items.map((item) => (
                    <li>
                      <h3>
                        {item.url ? (
                          <a
                            href={item.url}
                            target="_blank"
                            rel="noreferrer"
                            class="text-[var(--accent)]"
                          >
                            {item.name} ↗
                          </a>
                        ) : (
                          item.name
                        )}
                      </h3>
                      <p>{item.description}</p>
                    </li>
                  ))}
                </ul>
              </>
            </section>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
