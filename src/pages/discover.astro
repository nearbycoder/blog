---
import BaseLayout from '../layouts/BaseLayout.astro';
import {getCollection} from 'astro:content';
import {isArticlePublished} from '../lib/articles';
const articles=(await getCollection('articles')).filter(e=>isArticlePublished(e)).map(e=>({id:e.id,title:e.data.title,description:e.data.description,tags:e.data.tags,minutes:parseInt(e.data.readTime ?? '')||Math.max(1,Math.ceil((e.body ?? '').split(/\s+/).length/220))}));
const tags=[...new Set(articles.flatMap(e=>e.tags))].sort();
---
<BaseLayout title="Discover a story" description="Find an unexpected story that fits your interests and available reading time."><section class="page-shell">
<header class="page-intro"><p class="label">A different way in</p><h1 class="display">Leave a little<br/>room for surprise.</h1><p>Choose your time and interests. Find a story you might otherwise miss.</p></header>
<div class="reader-controls"><label>Topic<select id="discover-topic"><option value="">Any topic</option>{tags.map(tag=><option value={tag}>{tag}</option>)}</select></label><label>Time available<select id="discover-time"><option value="0">Any length</option><option value="5">5 minutes</option><option value="10">10 minutes</option><option value="15">15 minutes</option></select></label></div>
<label class="reading-remember"><input id="discover-unread" type="checkbox"/>Skip articles marked as read on this device</label>
<div class="reader-controls"><button class="btn btn-accent" id="discover-pick" disabled>Find a story</button><button class="btn" id="discover-reset" disabled>Start over</button></div>
<p role="status" id="discover-status">Suggestions need JavaScript. You can always browse the complete archive.</p><section id="discover-result" class="reader-panel" hidden><p class="label" id="discover-meta"></p><h2><a id="discover-link"></a></h2><p id="discover-description"></p></section>
<a href="/articles/" class="text-link">Browse all articles →</a>
<script is:inline type="application/json" id="discover-catalog" set:html={JSON.stringify(articles).replace(/</g,'\\u003c')}/>
</section></BaseLayout>
<script>
import {readReadingState} from '../lib/reading-storage';
type Story={id:string,title:string,description:string,tags:string[],minutes:number};
const stories:Story[]=JSON.parse(document.querySelector('#discover-catalog')!.textContent!);
const topic=document.querySelector<HTMLSelectElement>('#discover-topic')!,time=document.querySelector<HTMLSelectElement>('#discover-time')!,unread=document.querySelector<HTMLInputElement>('#discover-unread')!,pick=document.querySelector<HTMLButtonElement>('#discover-pick')!,reset=document.querySelector<HTMLButtonElement>('#discover-reset')!,status=document.querySelector<HTMLElement>('#discover-status')!,result=document.querySelector<HTMLElement>('#discover-result')!;
const seen=new Set<string>();
function available(){const state=readReadingState();return stories.filter(s=>(!topic.value||s.tags.includes(topic.value))&&(!Number(time.value)||s.minutes<=Number(time.value))&&(!unread.checked||!state[s.id]?.completed));}
function refresh(){const pool=available().filter(s=>!seen.has(s.id));pick.disabled=!pool.length;reset.disabled=!seen.size;status.textContent=pool.length?`${pool.length} stories left to discover. Suggestions do not repeat until you start over.`:'No stories left with these choices. Change a filter or start over.';}
for(const control of [topic,time,unread])control.addEventListener('change',()=>{seen.clear();result.hidden=true;refresh();});
reset.addEventListener('click',()=>{seen.clear();result.hidden=true;refresh();pick.focus();});
pick.addEventListener('click',()=>{const pool=available().filter(s=>!seen.has(s.id));if(!pool.length)return;const values=new Uint32Array(1);crypto.getRandomValues(values);const story=pool[values[0]%pool.length];seen.add(story.id);const link=document.querySelector<HTMLAnchorElement>('#discover-link')!;link.href=`/articles/${story.id}/`;link.textContent=story.title;document.querySelector('#discover-description')!.textContent=story.description;document.querySelector('#discover-meta')!.textContent=`${story.minutes} min read · ${story.tags.join(' / ')}`;result.hidden=false;refresh();link.focus();});refresh();
</script>
