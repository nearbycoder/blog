---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import ArticleCard from "../components/ArticleCard.astro";
import ProjectCard from "../components/ProjectCard.astro";
import WorkTimeline from "../components/WorkTimeline.astro";
import { getCollection } from "astro:content";
import { site } from "../data/site";
import { isArticlePublished } from "../lib/articles";

const articles = (await getCollection("articles")) as any[];
const includeScheduled = !import.meta.env.PROD;
const sortedArticles = articles
  .filter((entry: any) => isArticlePublished(entry, { includeScheduled }))
  .sort((a: any, b: any) => b.data.date.localeCompare(a.data.date));
const featuredArticles = sortedArticles.slice(0, 3);

const projects = (await getCollection("projects")) as any[];
const pinnedProjectSlug = "dailystand-dev";
const sortedProjects = projects
  .filter((entry: any) => !entry.data.draft)
  .sort((a: any, b: any) => {
    const aIsPinned = a.slug === pinnedProjectSlug;
    const bIsPinned = b.slug === pinnedProjectSlug;

    if (aIsPinned && !bIsPinned) return -1;
    if (!aIsPinned && bIsPinned) return 1;

    return b.data.year.localeCompare(a.data.year);
  });
const featuredProjects = sortedProjects.filter((entry: any) => entry.data.featured).slice(0, 2);
---

<BaseLayout>
  <Hero />

  <section class="mt-20 space-y-10 reveal" style="--delay: 80ms">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="text-xs uppercase tracking-[0.3em] text-[color:var(--fog-500)]">Writing</p>
        <h2 class="text-3xl font-semibold text-white md:text-4xl">Latest articles</h2>
      </div>
      <a href="/articles" class="text-xs uppercase tracking-[0.2em] text-[color:var(--mist-200)] hover:text-white">
        View all
      </a>
    </div>
    <div class="grid gap-6 md:grid-cols-3">
      {featuredArticles.map((entry: any, index: number) => (
        <ArticleCard entry={entry} index={index} />
      ))}
    </div>
  </section>

  <section class="mt-20 space-y-10 reveal" style="--delay: 160ms">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="text-xs uppercase tracking-[0.3em] text-[color:var(--fog-500)]">Projects</p>
        <h2 class="text-3xl font-semibold text-white md:text-4xl">Selected builds</h2>
      </div>
      <a href="/projects" class="text-xs uppercase tracking-[0.2em] text-[color:var(--mist-200)] hover:text-white">
        View all
      </a>
    </div>
    <div class="grid gap-6 md:grid-cols-2">
      {featuredProjects.map((project: any, index: number) => (
        <ProjectCard project={project} index={index} />
      ))}
    </div>
  </section>

  <section class="mt-20 space-y-10 reveal" style="--delay: 240ms">
    <div>
      <p class="text-xs uppercase tracking-[0.3em] text-[color:var(--fog-500)]">Experience</p>
      <h2 class="text-3xl font-semibold text-white md:text-4xl">Where I've built</h2>
    </div>
    <WorkTimeline />
  </section>

  <section class="mt-20 reveal" style="--delay: 320ms">
    <div class="card grid gap-6 rounded-[32px] p-8 md:grid-cols-[1.2fr_0.8fr] md:items-center md:p-10 bg-grid">
      <div class="space-y-4">
        <p class="text-xs uppercase tracking-[0.3em] text-[color:var(--fog-500)]">Get In Touch</p>
        <h2 class="text-3xl font-semibold text-white">Contact me directly</h2>
        <p class="text-sm text-[color:var(--mist-200)]">
          Send a quick note about opportunities, collaborations, or anything interesting you're building.
        </p>
      </div>
      <form
        action="mailto:nearbycoder@gmail.com"
        method="post"
        enctype="text/plain"
        class="grid gap-3"
        autocomplete="off"
        data-1p-ignore="true"
        data-lpignore="true"
      >
        <input
          type="text"
          name="name"
          placeholder="Your name"
          class="w-full rounded-full border border-white/10 bg-white/5 px-4 py-3 text-sm text-white placeholder:text-white/40"
          autocomplete="off"
          data-1p-ignore="true"
          data-lpignore="true"
          required
        />
        <input
          type="email"
          name="email"
          placeholder="Your email"
          class="w-full rounded-full border border-white/10 bg-white/5 px-4 py-3 text-sm text-white placeholder:text-white/40"
          autocomplete="off"
          data-1p-ignore="true"
          data-lpignore="true"
          required
        />
        <textarea
          name="message"
          placeholder="Your message"
          rows={4}
          class="w-full rounded-3xl border border-white/10 bg-white/5 px-4 py-3 text-sm text-white placeholder:text-white/40"
          autocomplete="off"
          data-1p-ignore="true"
          data-lpignore="true"
          required
        ></textarea>
        <button
          type="submit"
          class="rounded-full border border-white/10 bg-white/10 px-4 py-3 text-xs uppercase tracking-[0.2em] text-white"
        >
          Send message
        </button>
        <p class="text-xs text-[color:var(--fog-500)]">Opens your email app and sends to nearbycoder@gmail.com.</p>
      </form>
    </div>
  </section>
</BaseLayout>
