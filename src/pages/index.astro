---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Marquee from "../components/Marquee.astro";
import ArticleCard from "../components/ArticleCard.astro";
import ProjectCard from "../components/ProjectCard.astro";
import LayoffEntryCard from "../components/LayoffEntryCard.astro";
import WorkTimeline from "../components/WorkTimeline.astro";
import { getCollection } from "astro:content";
import { compareArticlesByPublishDateDesc, isArticlePublished } from "../lib/articles";

const articles = (await getCollection("articles")) as any[];
const includeScheduled = !import.meta.env.PROD;
const sortedArticles = articles
  .filter((entry: any) => isArticlePublished(entry, { includeScheduled }))
  .sort((a: any, b: any) => compareArticlesByPublishDateDesc(a, b));
const featuredArticles = sortedArticles.slice(0, 3);

const projects = (await getCollection("projects")) as any[];
const pinnedProjectSlug = "easyaccessqr-com";
const sortedProjects = projects
  .filter((entry: any) => !entry.data.draft)
  .sort((a: any, b: any) => {
    const aIsPinned = a.id === pinnedProjectSlug;
    const bIsPinned = b.id === pinnedProjectSlug;

    if (aIsPinned && !bIsPinned) return -1;
    if (!aIsPinned && bIsPinned) return 1;

    return b.data.year.localeCompare(a.data.year);
  });
const selectedBuildProjectSlugs = ["agfs-dev", "dailystand-dev"];
const selectedBuildProjectSet = new Set(selectedBuildProjectSlugs);
const featuredProjects = [
  ...selectedBuildProjectSlugs
    .map((slug) => sortedProjects.find((entry: any) => entry.id === slug && entry.data.featured))
    .filter(Boolean),
  ...sortedProjects.filter((entry: any) => entry.data.featured && !selectedBuildProjectSet.has(entry.id)),
].slice(0, 2);
const layoffEntries = (await getCollection("layoff")) as any[];
const recentLayoffEntries = layoffEntries
  .filter((entry: any) => !entry.data.draft)
  .sort((a: any, b: any) => b.data.date.localeCompare(a.data.date))
  .slice(0, 2);
---

<BaseLayout>
  <Hero />

  <div class="mt-10 reveal" style="--delay: 60ms;">
    <Marquee />
  </div>

  <section class="mt-24 space-y-8 reveal" style="--delay: 80ms;">
    <header class="section-head">
      <div class="space-y-1">
        <p class="label-strong">No. 01 — Field notes</p>
        <h2 class="display text-5xl md:text-6xl">Latest <em>articles</em></h2>
      </div>
      <a href="/articles" class="btn">All articles</a>
    </header>
    <div class="article-archive-grid">
      {featuredArticles.map((entry: any, index: number) => (
        <ArticleCard entry={entry} index={index} />
      ))}
    </div>
  </section>

  <section class="mt-24 space-y-8 reveal" style="--delay: 160ms;">
    <header class="section-head">
      <div class="space-y-1">
        <p class="label-strong">No. 02 — Workbench</p>
        <h2 class="display text-5xl md:text-6xl">Selected <em>builds</em></h2>
      </div>
      <a href="/projects" class="btn">All projects</a>
    </header>
    <div class="grid gap-x-12 md:grid-cols-2">
      {featuredProjects.map((project: any, index: number) => (
        <ProjectCard project={project} index={index} />
      ))}
    </div>
  </section>

  {recentLayoffEntries.length > 0 && (
    <section class="mt-24 space-y-8 reveal" style="--delay: 200ms;">
      <header class="section-head">
        <div class="space-y-1">
          <p class="label-strong">No. 03 — Build diary</p>
          <h2 class="display text-5xl md:text-6xl">Weekly <em>updates</em></h2>
        </div>
        <a href="/layoff" class="btn">Full log</a>
      </header>
      <div class="grid gap-x-12 md:grid-cols-2">
        {recentLayoffEntries.map((entry: any, index: number) => (
          <LayoffEntryCard entry={entry} index={index} />
        ))}
      </div>
    </section>
  )}

  <section class="mt-24 space-y-8 reveal" style="--delay: 240ms;">
    <header class="section-head">
      <div class="space-y-1">
        <p class="label-strong">No. 04 — Timeline</p>
        <h2 class="display text-5xl md:text-6xl">Where I've <em>built</em></h2>
      </div>
    </header>
    <WorkTimeline />
  </section>
</BaseLayout>
