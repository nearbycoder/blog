---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import ArticleCard from "../components/ArticleCard.astro";
import ProjectCard from "../components/ProjectCard.astro";
import LayoffEntryCard from "../components/LayoffEntryCard.astro";
import WorkTimeline from "../components/WorkTimeline.astro";
import { getCollection } from "astro:content";
import { compareArticlesByPublishDateDesc, isArticlePublished } from "../lib/articles";

const articles = (await getCollection("articles")) as any[];
const includeScheduled = !import.meta.env.PROD;
const sortedArticles = articles
  .filter((entry: any) => isArticlePublished(entry, { includeScheduled }))
  .sort((a: any, b: any) => compareArticlesByPublishDateDesc(a, b));
const featuredArticles = sortedArticles.slice(0, 3);

const projects = (await getCollection("projects")) as any[];
const pinnedProjectSlug = "easyaccessqr-com";
const sortedProjects = projects
  .filter((entry: any) => !entry.data.draft)
  .sort((a: any, b: any) => {
    const aIsPinned = a.slug === pinnedProjectSlug;
    const bIsPinned = b.slug === pinnedProjectSlug;

    if (aIsPinned && !bIsPinned) return -1;
    if (!aIsPinned && bIsPinned) return 1;

    return b.data.year.localeCompare(a.data.year);
  });
const featuredProjects = sortedProjects.filter((entry: any) => entry.data.featured).slice(0, 2);
const layoffEntries = (await getCollection("layoff")) as any[];
const recentLayoffEntries = layoffEntries
  .filter((entry: any) => !entry.data.draft)
  .sort((a: any, b: any) => b.data.date.localeCompare(a.data.date))
  .slice(0, 2);
---

<BaseLayout>
  <Hero />

  <section class="mt-20 space-y-10 reveal" style="--delay: 80ms">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="text-xs uppercase tracking-[0.3em] text-[color:var(--fog-500)]">Writing</p>
        <h2 class="text-3xl font-semibold text-white md:text-4xl">Latest articles</h2>
      </div>
      <a href="/articles" class="text-xs uppercase tracking-[0.2em] text-[color:var(--mist-200)] hover:text-white">
        View all
      </a>
    </div>
    <div class="grid gap-6 md:grid-cols-3">
      {featuredArticles.map((entry: any, index: number) => (
        <ArticleCard entry={entry} index={index} />
      ))}
    </div>
  </section>

  <section class="mt-20 space-y-10 reveal" style="--delay: 160ms">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="text-xs uppercase tracking-[0.3em] text-[color:var(--fog-500)]">Projects</p>
        <h2 class="text-3xl font-semibold text-white md:text-4xl">Selected builds</h2>
      </div>
      <a href="/projects" class="text-xs uppercase tracking-[0.2em] text-[color:var(--mist-200)] hover:text-white">
        View all
      </a>
    </div>
    <div class="grid gap-6 md:grid-cols-2">
      {featuredProjects.map((project: any, index: number) => (
        <ProjectCard project={project} index={index} />
      ))}
    </div>
  </section>

  {recentLayoffEntries.length > 0 && (
    <section class="mt-20 space-y-10 reveal" style="--delay: 200ms">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="text-xs uppercase tracking-[0.3em] text-[color:var(--fog-500)]">Layoff Log</p>
          <h2 class="text-3xl font-semibold text-white md:text-4xl">Weekly build updates</h2>
        </div>
        <a href="/layoff" class="text-xs uppercase tracking-[0.2em] text-[color:var(--mist-200)] hover:text-white">
          View all
        </a>
      </div>
      <div class="grid gap-6 md:grid-cols-2">
        {recentLayoffEntries.map((entry: any, index: number) => (
          <LayoffEntryCard entry={entry} index={index} />
        ))}
      </div>
    </section>
  )}

  <section class="mt-20 space-y-10 reveal" style="--delay: 240ms">
    <div>
      <p class="text-xs uppercase tracking-[0.3em] text-[color:var(--fog-500)]">Experience</p>
      <h2 class="text-3xl font-semibold text-white md:text-4xl">Where I've built</h2>
    </div>
    <WorkTimeline />
  </section>

</BaseLayout>
