---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import ShareArticle from "../../components/ShareArticle.astro";
import { getCollection, render } from "astro:content";
import { formatDate } from "../../lib/media";
export async function getStaticPaths() {
  return (await getCollection("layoff"))
    .filter((entry) => !entry.data.draft)
    .map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const cadence = entry.data.week
  ? `Week ${entry.data.week}`
  : entry.data.day
    ? `Day ${entry.data.day}`
    : "Build update";
const entries = (await getCollection("layoff"))
  .filter((item) => !item.data.draft)
  .sort((a, b) => a.data.date.localeCompare(b.data.date));
const next = entries[entries.findIndex((item) => item.id === entry.id) + 1];
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.summary}
  type="article"
>
  <article>
    <header class="reading-header">
      <a href="/layoff" class="nav-link">← Layoff Log</a><h1 class="display">
        {entry.data.title}
      </h1><p class="deck">{entry.data.summary}</p><div class="meta-row mt-6">
        <time datetime={entry.data.date}>{formatDate(entry.data.date)}</time
        ><span>{cadence}</span><span class="meta-topic"
          >{entry.data.status}</span>
      </div>
    </header>
    {
      entry.data.image && (
        <div class="reading-cover">
          <img
            src={entry.data.image}
            alt={entry.data.title}
            width="1200"
            height="600"
          />
        </div>
      )
    }
    <div class="reading-layout">
      <aside class="reading-sidebar">
        <p class="label">Built with</p><div class="mt-4 flex flex-wrap gap-2">
          {entry.data.stack.map((item) => <span class="chip">{item}</span>)}
        </div><div class="mt-5 grid gap-2">
          {
            entry.data.siteUrl !== entry.data.repoUrl && (
              <a
                href={entry.data.siteUrl}
                class="text-link"
                target="_blank"
                rel="noreferrer"
              >
                Visit site <Icon name="external" />
              </a>
            )
          }<a
            href={entry.data.repoUrl}
            class="text-link"
            target="_blank"
            rel="noreferrer">View code <Icon name="external" /></a>
        </div><ShareArticle />
      </aside><div>
        <div class="article-content"><Content /></div><div class="reading-end">
          {
            next ? (
              <a href={`/layoff/${next.id}`} class="text-link">
                Next: {next.data.title} <Icon name="arrow" />
              </a>
            ) : (
              <a href="/layoff" class="text-link">
                Back to the full log <Icon name="arrow" />
              </a>
            )
          }
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
