---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const entries = (await getCollection("layoff")) as any[];
  return entries.filter((entry: any) => !entry.data.draft).map((entry: any) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props as { entry: any };
const { Content } = await render(entry);
const cadenceLabel = entry.data.week ? `Week ${entry.data.week}` : entry.data.day ? `Day ${entry.data.day}` : null;
const hasDistinctSiteUrl =
  typeof entry.data.siteUrl === "string" &&
  typeof entry.data.repoUrl === "string" &&
  entry.data.siteUrl !== entry.data.repoUrl;
---

<BaseLayout title={entry.data.title}>
  <article class="mx-auto mt-10 max-w-3xl space-y-10">
    <header class="rule-b-heavy pb-6 space-y-4" style="border-color: var(--border);">
      <div class="flex items-center gap-3">
        <a href="/layoff" class="nav-link">← Layoff Log</a>
        <span class="dot dot-accent"></span>
        <span class="font-mono text-xs uppercase tracking-[0.14em]" style="color: var(--fg-muted);">
          {entry.data.date}{cadenceLabel ? ` · ${cadenceLabel}` : ""} · {entry.data.status}
        </span>
      </div>
      <h1 class="display text-4xl md:text-6xl">{entry.data.title}</h1>
      <p class="text-lg leading-relaxed" style="color: var(--fg-muted);">{entry.data.summary}</p>
      <div class="flex flex-wrap gap-2">
        {hasDistinctSiteUrl ? (
          <a
            href={entry.data.siteUrl}
            target="_blank"
            rel="noreferrer"
            class="btn btn-accent"
          >
            Visit site ↗
          </a>
        ) : null}
        <a
          href={entry.data.repoUrl}
          target="_blank"
          rel="noreferrer"
          class="btn"
        >
          View code ↗
        </a>
      </div>
    </header>

    {entry.data.stack?.length ? (
      <div class="flex flex-wrap gap-1.5">
        {entry.data.stack.map((item: string) => (
          <span class="chip">{item}</span>
        ))}
      </div>
    ) : null}

    <div class="article-content">
      <Content />
    </div>
  </article>
</BaseLayout>
