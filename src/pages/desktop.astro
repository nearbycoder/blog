---
import Arcade from "../components/desktop/Arcade.astro";
import "../styles/desktop-arcade.css";
import BaseLayout from "../layouts/BaseLayout.astro";
import DesktopIcon from "../components/desktop/DesktopIcon.astro";
import { desktopFolders, getDesktopFiles } from "../lib/desktop";
import "../styles/desktop.css";
const files = await getDesktopFiles();
const folderFor = (id: string) =>
  desktopFolders.find((folder) => folder.id === id)!;
---

<BaseLayout
  desktop
  title="Desktop"
  description="An experimental desktop for exploring Josh Hamilton’s writing, projects, and experiments."
>
  <script is:inline>
    document.documentElement.classList.add("has-desktop-js");
  </script>
  <div class="desktop-environment" data-desktop>
    <div class="desktop-workspace" data-workspace>
      <nav class="desktop-shortcuts" aria-label="Desktop shortcuts">
        {
          desktopFolders
            .filter((folder) =>
              ["articles", "projects", "lab", "pages"].includes(folder.id),
            )
            .map((folder) => (
              <button type="button" data-open-folder={folder.id}>
                <span class:list={["shortcut-art", `shortcut-${folder.id}`]}>
                  <DesktopIcon name={folder.icon} />
                </span>
                <span>
                  {folder.id === "pages" ? "About & more" : folder.label}
                </span>
              </button>
            ))
        }
        <button type="button" data-open-arcade>
          <span class="shortcut-art shortcut-arcade"
            ><DesktopIcon name="game" /></span
          ><span>Arcade</span>
        </button>
      </nav>
      <div class="desktop-wallpaper-copy" aria-hidden="true">
        <strong>nearby</strong><span>DESKTOP</span>
      </div>
      <section
        class="desktop-window library-window is-active"
        data-window="library"
        role="region"
        aria-label="Library window"
        tabindex="-1"
      >
        <div class="window-titlebar" data-drag-handle>
          <span class="window-title"
            ><DesktopIcon name="folder" /><strong>Library</strong><span
              class="window-subtitle"
            >
              — File Manager</span
            ></span
          >
          <div class="window-controls">
            <button
              type="button"
              data-window-action="minimize"
              aria-label="Minimize Library"
              ><DesktopIcon name="minimize" /></button
            >
            <button
              type="button"
              data-window-action="maximize"
              aria-label="Maximize Library"
              aria-pressed="false"><DesktopIcon name="maximize" /></button
            >
            <button
              type="button"
              data-window-action="close"
              aria-label="Close Library"><DesktopIcon name="close" /></button
            >
          </div>
        </div>
        <div class="library-toolbar">
          <button
            class="toolbar-home"
            type="button"
            data-open-folder="all"
            aria-label="Go to all files"
            title="All files"><DesktopIcon name="home" /></button
          >
          <div class="library-location">
            <span>Home</span><DesktopIcon name="chevronRight" /><span
              data-breadcrumb>All files</span
            >
          </div>
          <label class="desktop-search"
            ><DesktopIcon name="search" /><span class="sr-only"
              >Search desktop files</span
            ><input
              type="search"
              placeholder="Search files…"
              data-desktop-search
              autocomplete="off"
            /><kbd>Ctrl K</kbd></label
          >
          <div class="file-view-controls" role="group" aria-label="File view">
            <button
              type="button"
              data-file-view="list"
              aria-label="Details view"
              aria-pressed="true"
              title="Details view"><DesktopIcon name="list" /></button
            >
            <button
              type="button"
              data-file-view="grid"
              aria-label="Icons view"
              aria-pressed="false"
              title="Icons view"><DesktopIcon name="grid" /></button
            >
          </div>
        </div>
        <div class="library-body">
          <nav class="library-sidebar" aria-label="Library folders">
            <p>Places</p>
            {
              desktopFolders.map((folder) => (
                <button
                  type="button"
                  data-folder={folder.id}
                  aria-pressed={folder.id === "all"}
                >
                  <>
                    <DesktopIcon name={folder.icon} />
                    <span>{folder.label}</span>
                    <small>
                      {folder.id === "all"
                        ? files.length
                        : files.filter((file) => file.folder === folder.id)
                            .length}
                    </small>
                  </>
                </button>
              ))
            }
            <div class="library-sidebar-note">
              <DesktopIcon name="drive" /><span>nearbycoder.com</span>
            </div>
          </nav>
          <div class="library-content">
            <div class="library-intro">
              <h1 data-folder-title>All files</h1><span>Home / nearbycoder</span
              >
            </div>
            <div class="file-list-head" aria-hidden="true">
              <span>Name</span><span>Type</span><span>Details</span>
            </div>
            <ul class="desktop-files">
              {
                files.map((file) => (
                  <li
                    data-file
                    data-file-folder={file.folder}
                    data-file-search={`${file.title} ${file.description} ${file.keywords}`.toLowerCase()}
                  >
                    <a
                      href={file.url}
                      data-desktop-file
                      data-file-title={file.title}
                      title={file.description}
                    >
                      <span
                        class:list={["file-icon", `file-icon-${file.folder}`]}
                      >
                        <DesktopIcon name={folderFor(file.folder).icon} />
                      </span>
                      <span class="file-copy">
                        <>
                          <strong>{file.title}</strong>
                          <span>{file.description}</span>
                        </>
                      </span>
                      <span class="file-kind">{file.kind}</span>
                      <span class="file-date">{file.detail || "—"}</span>
                    </a>
                  </li>
                ))
              }
            </ul>
            <div class="desktop-empty" data-desktop-empty hidden>
              <DesktopIcon name="search" /><h2>No files found</h2><p>
                Try another phrase or choose All files.
              </p><button type="button" data-clear-search>Clear search</button>
            </div>
          </div>
        </div>
        <footer class="library-status">
          <span data-file-count aria-live="polite">{files.length} files</span
          ><span>Click to open · Drag a title bar to move</span>
        </footer>
      </section>
    </div>
    <section
      id="desktop-launcher"
      class="shell-popup desktop-launcher"
      aria-label="Application launcher"
      hidden
    >
      <header class="launcher-heading">
        <span class="user-avatar">N</span><div>
          <strong>nearbycoder</strong><span>Applications & places</span>
        </div>
      </header>
      <label class="launcher-search"
        ><DesktopIcon name="search" /><span class="sr-only"
          >Search applications and files</span
        ><input
          type="search"
          data-launcher-search
          placeholder="Search applications and files…"
          autocomplete="off"
        /></label
      >
      <div data-launcher-default>
        <p class="launcher-section-label">Favorites</p>
        <div class="launcher-apps">
          <button type="button" data-launch-action="library"
            ><span class="app-glyph app-files"
              ><DesktopIcon name="folder" /></span
            ><strong>Files</strong><span>Browse the blog</span></button
          >
          <button type="button" data-launch-action="arcade"
            ><span class="app-glyph app-arcade"
              ><DesktopIcon name="game" /></span
            ><strong>Arcade</strong><span>Games & surprises</span></button
          >
          <button type="button" data-launch-action="terminal"
            ><span class="app-glyph app-terminal"
              ><DesktopIcon name="terminal" /></span
            ><strong>Terminal</strong><span>Pocket shell</span></button
          >
        </div>
        <p class="launcher-section-label">Places</p>
        <div class="launcher-places">
          {
            desktopFolders
              .filter((folder) =>
                ["articles", "projects", "pages"].includes(folder.id),
              )
              .map((folder) => (
                <button type="button" data-launch-folder={folder.id}>
                  <DesktopIcon name={folder.icon} />
                  {folder.label}
                  <DesktopIcon name="chevronRight" />
                </button>
              ))
          }
        </div>
      </div>
      <div class="launcher-results" data-launcher-results hidden>
        <p data-launcher-count aria-live="polite"></p><ul></ul>
      </div>
      <footer class="launcher-footer">
        <span><DesktopIcon name="desktop" />Nearby Desktop</span><a
          href="/"
          aria-label="Return to blog"
          ><DesktopIcon name="logout" />Leave desktop</a
        >
      </footer>
    </section>
    <section
      id="desktop-calendar"
      class="shell-popup desktop-calendar"
      aria-label="Calendar"
      hidden
    >
      <header>
        <button
          type="button"
          data-calendar-step="-1"
          aria-label="Previous month"><DesktopIcon name="chevronLeft" /></button
        ><h2 data-calendar-month></h2><button
          type="button"
          data-calendar-step="1"
          aria-label="Next month"><DesktopIcon name="chevronRight" /></button
        >
      </header>
      <div class="calendar-weekdays" aria-hidden="true">
        {["S", "M", "T", "W", "T", "F", "S"].map((day) => <span>{day}</span>)}
      </div>
      <div class="calendar-days" data-calendar-days></div><button
        type="button"
        class="calendar-today"
        data-calendar-today>Today</button
      >
    </section>
    <nav class="desktop-dock" aria-label="Open windows">
      <button
        type="button"
        class="panel-launcher"
        data-launcher-toggle
        aria-controls="desktop-launcher"
        aria-expanded="false"
        aria-label="Open application launcher"
        title="Application launcher (Ctrl+Esc)"
        ><DesktopIcon name="apps" /></button
      >
      <span class="dock-divider" aria-hidden="true"></span>
      <button
        type="button"
        class="dock-library panel-app app-files"
        data-show-library
        aria-label="Open Library"
        title="File Manager"><DesktopIcon name="folder" /></button
      >
      <button
        type="button"
        class="panel-app app-arcade"
        data-open-arcade
        aria-label="Open Arcade"
        title="Arcade"><DesktopIcon name="game" /></button
      >
      <button
        type="button"
        class="panel-app app-terminal"
        data-open-terminal
        aria-label="Open Terminal"
        title="Terminal"><DesktopIcon name="terminal" /></button
      >
      <div class="desktop-tasks" data-desktop-tasks></div>
      <div class="panel-tray">
        <button
          type="button"
          data-desktop-reset
          title="Arrange windows"
          aria-label="Arrange windows"><DesktopIcon name="reset" /></button
        >
        <button
          type="button"
          data-desktop-theme
          title="Toggle color theme"
          aria-label="Toggle color theme"><DesktopIcon name="moon" /></button
        >
        <a href="/" title="Back to blog" aria-label="Back to blog"
          ><DesktopIcon name="globe" /></a
        >
        <button
          type="button"
          class="panel-clock"
          data-calendar-toggle
          aria-label="Open calendar"
          aria-controls="desktop-calendar"
          aria-expanded="false"
          ><time data-panel-time>--:--</time><span data-panel-date
          ></span></button
        >
      </div>
      <button
        type="button"
        class="panel-show-desktop"
        data-show-desktop
        aria-label="Show desktop"
        aria-pressed="false"
        title="Show desktop"><DesktopIcon name="desktop" /></button
      >
    </nav>
    <p class="sr-only" role="status" data-desktop-status></p>
    <noscript
      ><p class="desktop-noscript">
        Enable JavaScript to move windows and search. All file links still open
        normally, or <a href="/">return to the blog</a>.
      </p></noscript
    >
  </div>
  <Arcade />
  <template id="desktop-reader-template">
    <section class="desktop-window reader-window" role="region" tabindex="-1">
      <div class="window-titlebar" data-drag-handle>
        <span class="window-title"
          ><DesktopIcon name="writing" /><strong data-reader-title
          ></strong></span
        >
        <div class="window-controls">
          <button type="button" data-window-action="minimize"
            ><DesktopIcon name="minimize" /></button
          >
          <button
            type="button"
            data-window-action="maximize"
            aria-pressed="false"><DesktopIcon name="maximize" /></button
          >
          <button type="button" data-window-action="close"
            ><DesktopIcon name="close" /></button
          >
        </div>
      </div>
      <div class="reader-toolbar">
        <span data-reader-location></span><a
          data-reader-original
          target="_blank"
          rel="noopener">Open in a tab <DesktopIcon name="external" /></a
        >
      </div>
      <p class="reader-loading" data-reader-loading role="status">
        Opening page… If it doesn’t load, use “Open in a tab”.
      </p>
      <iframe data-desktop-reader></iframe>
    </section>
  </template>
</BaseLayout>
<script>
  import "../scripts/desktop";
</script>
