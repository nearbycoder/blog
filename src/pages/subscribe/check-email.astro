---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Check your inbox"
  description="Confirm your email to subscribe to Nearbycoder."
  ><section class="page-shell">
    <header class="page-intro">
      <p class="label">One more step</p><h1 class="display">
        Check your inbox.
      </h1><p>
        Look for a confirmation email from Josh Hamilton. Open its link to
        finish subscribing. You won’t receive posts until you confirm.
      </p>
    </header><div class="subscription-confirm">
      <p>
        If it hasn’t arrived, check your spam folder or try again in a few
        minutes.
      </p><a href="/subscribe" class="text-link">Back to subscriptions →</a>
    </div>
  </section></BaseLayout
>
