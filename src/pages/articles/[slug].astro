---
import AdjacentArticles from "../../components/AdjacentArticles.astro";
import ReaderPreferences from "../../components/ReaderPreferences.astro";
import FocusReading from "../../components/FocusReading.astro";
import NewsletterInvite from "../../components/NewsletterInvite.astro";
import ReadingTools from "../../components/ReadingTools.astro";
import CopyCode from "../../components/CopyCode.astro";
import ArticleContext from "../../components/ArticleContext.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import ShareArticle from "../../components/ShareArticle.astro";
import { getCollection, render } from "astro:content";
import {
  isArticlePublished,
  compareArticlesByPublishDateDesc,
} from "../../lib/articles";
import { articleImage, formatDate } from "../../lib/media";
export async function getStaticPaths() {
  return (await getCollection("articles"))
    .filter((entry) =>
      isArticlePublished(entry, { includeScheduled: !import.meta.env.PROD }),
    )
    .map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const related = (await getCollection("articles"))
  .filter(
    (item) =>
      item.id !== entry.id &&
      isArticlePublished(item, { includeScheduled: !import.meta.env.PROD }),
  )
  .sort((a, b) => {
    const score = (item: typeof a) =>
      item.data.tags.filter((tag) => entry.data.tags.includes(tag)).length;
    return score(b) - score(a) || compareArticlesByPublishDateDesc(a, b);
  })
  .slice(0, 3);
const toc = headings.filter((heading) => heading.depth === 2);
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  type="article"
  imageAlt={entry.data.title}
>
  <article>
    <header class="reading-header">
      <a href="/articles" class="nav-link">← All articles</a><h1
        class="display"
      >
        {entry.data.title}
      </h1><p class="deck">{entry.data.description}</p><div
        class="reading-author"
      >
        <img src="/images/portrait.webp" alt="" width="36" height="36" /><a
          href="/about">Josh Hamilton</a
        ><span aria-hidden="true">·</span><time datetime={entry.data.date}
          >{formatDate(entry.data.date)}</time
        ><span>{entry.data.readTime}</span>
      </div>
    </header>
    <div class="reading-cover">
      <img
        src={articleImage(entry)}
        alt=""
        width="1200"
        height="600"
        fetchpriority="high"
      />
    </div>
    <div class="reading-layout">
      <aside class="reading-sidebar">
        {
          toc.length > 0 && (
            <nav aria-label="On this page">
              <>
                <p class="label">On this page</p>
                <div class="toc">
                  {toc.map((heading) => (
                    <a href={`#${heading.slug}`}>{heading.text}</a>
                  ))}
                </div>
              </>
            </nav>
          )
        }<ShareArticle /><ReadingTools id={entry.id} />
      </aside><div>
        <div id="reading-resume" class="reading-resume" hidden>
          <p class="label">Pick up where you left off</p><a
            class="text-link"
            href="#main-content">Continue reading →</a
          >
        </div><FocusReading /><ReaderPreferences /><div class="article-content">
          <Content />
        </div><div class="reading-finish">
          <button id="mark-reading-complete" class="btn" disabled
            >Mark as read</button
          >
        </div><AdjacentArticles id={entry.id} /><ArticleContext
          articleId={entry.id}
        /><div class="reading-end">
          <div class="flex flex-wrap gap-2">
            {
              entry.data.tags.map((tag) => (
                <a
                  class="chip"
                  href={`/topics/${encodeURIComponent(tag.toLowerCase())}/`}
                >
                  {tag}
                </a>
              ))
            }
          </div><a href="/articles" class="text-link">Back to all articles →</a>
        </div>
      </div>
    </div>
  </article>
  {
    related.length > 0 && (
      <section class="home-section">
        <>
          <header class="section-head">
            <h2>Keep the curiosity going</h2>
          </header>
          <div class="article-archive-grid">
            {related.map((item) => (
              <ArticleCard entry={item} />
            ))}
          </div>
        </>
      </section>
    )
  }
  <NewsletterInvite /><CopyCode /></BaseLayout
>
<script>
  const links = Array.from(
    document.querySelectorAll<HTMLAnchorElement>(".toc a"),
  );
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          links.forEach((link) => {
            if (link.hash === `#${entry.target.id}`)
              link.setAttribute("aria-current", "location");
            else link.removeAttribute("aria-current");
          });
        }
      }
    },
    { rootMargin: "-15% 0px -65% 0px" },
  );
  document
    .querySelectorAll(".article-content h2")
    .forEach((heading) => observer.observe(heading));
</script>
