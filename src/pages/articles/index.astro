---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { getCollection } from "astro:content";
import { compareArticlesByPublishDateDesc, isArticlePublished } from "../../lib/articles";

const articles = (await getCollection("articles")) as any[];
const includeScheduled = !import.meta.env.PROD;
const sortedArticles = articles
  .filter((entry: any) => isArticlePublished(entry, { includeScheduled }))
  .sort((a: any, b: any) => compareArticlesByPublishDateDesc(a, b));
---

<BaseLayout title="Articles">
  <section class="page-shell space-y-8">
    <header class="page-intro">
      <p class="paper-strip">Articles / {sortedArticles.length} entries</p>
      <h1 class="display max-w-4xl text-6xl md:text-7xl">
        Writing through <span class="marker">layoffs</span>,
        building, and adaptation.
      </h1>
      <p class="max-w-2xl text-base leading-relaxed" style="color: var(--fg-muted);">
        Personal notes on job searching, shipping with AI, and rebuilding momentum one project at a time.
      </p>
    </header>

    <div class="block-box block-box-shadow flex flex-col gap-2 px-4 py-3 sm:flex-row sm:items-center">
      <label for="article-search" class="label-strong shrink-0">Search /</label>
      <input
        id="article-search"
        type="search"
        placeholder="Title, tag, or description…"
        class="w-full bg-transparent font-mono text-base outline-none"
        style="color: var(--fg);"
      />
    </div>

    <p id="articles-empty" class="hidden font-mono text-sm" style="color: var(--fg-muted);">
      No articles match that search.
    </p>

    <div id="articles-grid" class="article-archive-grid">
      {sortedArticles.map((entry: any, index: number) => (
        <div
          data-article
          data-search={`${entry.data.title} ${entry.data.description} ${entry.data.tags?.join(" ") ?? ""}`}
          class="h-full"
        >
          <ArticleCard entry={entry} index={index} />
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (() => {
    const articleSearchInput = document.getElementById("article-search");
    const articleItems = Array.from(document.querySelectorAll("[data-article]"));
    const emptyState = document.getElementById("articles-empty");

    if (!articleSearchInput || articleItems.length === 0) return;

    const applyFilter = () => {
      const query = articleSearchInput.value.trim().toLowerCase();
      let visible = 0;

      articleItems.forEach((item) => {
        const haystack = (item.getAttribute("data-search") ?? "").toLowerCase();
        const match = query.length === 0 || haystack.includes(query);
        item.classList.toggle("hidden", !match);
        if (match) visible += 1;
      });

      if (emptyState) {
        emptyState.classList.toggle("hidden", visible !== 0);
      }
    };

    articleSearchInput.addEventListener("input", applyFilter);
    applyFilter();
  })();
</script>
