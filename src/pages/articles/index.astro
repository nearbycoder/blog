---
import CustomSelect from "../../components/CustomSelect.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import Icon from "../../components/Icon.astro";
import { getCollection } from "astro:content";
import {
  compareArticlesByPublishDateDesc,
  isArticlePublished,
} from "../../lib/articles";
const sortedArticles = (await getCollection("articles"))
  .filter((entry) =>
    isArticlePublished(entry, { includeScheduled: !import.meta.env.PROD }),
  )
  .sort(compareArticlesByPublishDateDesc);
const topics = [
  { label: "All writing", value: "" },
  { label: "AI & agents", value: "ai" },
  { label: "Engineering", value: "engineering" },
  { label: "Career", value: "career" },
  { label: "Building", value: "building" },
];
---

<BaseLayout
  title="Articles"
  description="Josh Hamilton’s notes on engineering, building with AI, career changes, and the human side of shipping software."
>
  <section class="page-shell space-y-8">
    <header class="page-intro">
      <p class="paper-strip">Articles · {sortedArticles.length} stories</p><h1
        class="display"
      >
        Thinking out loud.<br /><em>Writing it down.</em>
      </h1><p style="color:var(--fg-muted)">
        Experiments, hard lessons, and things worth sharing. Notes from a life
        spent making software.
      </p>
    </header>
    <a class="text-link" href="/archive/">Browse by date →</a>
    <a class="text-link" href="/topics/">Browse every topic →</a>
    <a class="text-link" href="/discover/">Find an unexpected story →</a>
    <a href="/start-here" class="text-link">New here? Pick a reading path →</a>
    <a href="/search/" class="text-link">Search inside every post →</a>
    <div class="search-toolbar">
      <Icon name="search" /><label for="article-search" class="sr-only"
        >Search articles</label
      ><input
        id="article-search"
        type="search"
        placeholder="Search by title, topic, or a passing thought…"
      /><span class="label shrink-0" id="article-count" aria-live="polite"
        >{sortedArticles.length} articles</span
      >
    </div>
    <div class="filter-bar" role="group" aria-label="Filter by topic">
      {
        topics.map((topic, index) => (
          <button
            type="button"
            class="filter-button"
            data-topic={topic.value}
            aria-pressed={index === 0 ? "true" : "false"}
          >
            {topic.label}
          </button>
        ))
      }
    </div>
    <div class="reader-controls">
      <CustomSelect
        id="article-budget"
        label="Reading time"
        options={[
          { value: "0", label: "Any length" },
          { value: "5", label: "Up to 5 minutes" },
          { value: "10", label: "Up to 10 minutes" },
          { value: "15", label: "Up to 15 minutes" },
        ]}
      />
      <CustomSelect
        id="article-sort"
        label="Sort articles"
        options={[
          { value: "newest", label: "Newest first" },
          { value: "oldest", label: "Oldest first" },
          { value: "shortest", label: "Shortest first" },
          { value: "title", label: "Title A–Z" },
        ]}
      />
    </div>
    <div id="articles-empty" class="empty-state" hidden>
      <p>No articles match those filters.</p><button
        type="button"
        id="clear-filters"
        class="btn">Clear filters</button
      >
    </div>
    <div id="articles-grid" class="article-archive-grid">
      {
        sortedArticles.map((entry) => (
          <div
            data-article
            data-minutes={
              parseInt(entry.data.readTime ?? "") ||
              Math.max(
                1,
                Math.ceil((entry.body ?? "").split(/\s+/).length / 220),
              )
            }
            data-title={entry.data.title}
            data-search={`${entry.data.title} ${entry.data.description} ${entry.data.tags.join(" ")}`}
            data-tags={entry.data.tags.join(" ")}
          >
            <ArticleCard entry={entry} heading="h2" />
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>
<script>
  import "../../lib/custom-select";
  import type { CustomSelectElement } from "../../lib/custom-select";
  const input = document.querySelector<HTMLInputElement>("#article-search")!;
  const items = Array.from(
    document.querySelectorAll<HTMLElement>("[data-article]"),
  );
  const buttons = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-topic]"),
  );
  const budget =
    document.querySelector<CustomSelectElement>("#article-budget")!;
  const sort = document.querySelector<CustomSelectElement>("#article-sort")!;
  let topic = "";
  function restore() {
    const params = new URLSearchParams(location.search);
    input.value = (params.get("q") ?? "").slice(0, 200);
    topic = ["", "ai", "engineering", "career", "building"].includes(
      params.get("topic") ?? "",
    )
      ? (params.get("topic") ?? "")
      : "";
    budget.value = ["0", "5", "10", "15"].includes(params.get("minutes") ?? "")
      ? params.get("minutes")!
      : "0";
    sort.value = ["newest", "oldest", "shortest", "title"].includes(
      params.get("sort") ?? "",
    )
      ? params.get("sort")!
      : "newest";
  }
  restore();
  const matchesTopic = (tags: string) =>
    !topic ||
    (topic === "building"
      ? /build|launch|project|shipping|opensource|saas/.test(tags)
      : topic === "ai"
        ? /\bai\b|agents|codex|claude/.test(tags)
        : topic === "career"
          ? /career|layoff|interview|job|motivation/.test(tags)
          : /engineering|react|development|developer|workflow|programming|reliability/.test(
              tags,
            ));
  const filter = () => {
    const query = input.value.toLowerCase().trim();
    let count = 0;
    items.forEach((item) => {
      item.hidden = !(
        item.dataset.search!.toLowerCase().includes(query) &&
        matchesTopic(item.dataset.tags!.toLowerCase()) &&
        (!Number(budget.value) ||
          Number(item.dataset.minutes) <= Number(budget.value))
      );
      if (!item.hidden) count++;
    });
    document.getElementById("articles-empty")!.hidden = count !== 0;
    document.getElementById("article-count")!.textContent =
      `${count} ${count === 1 ? "article" : "articles"}`;
    const ordered = [...items].sort((a, b) =>
      sort.value === "oldest"
        ? items.indexOf(b) - items.indexOf(a)
        : sort.value === "shortest"
          ? Number(a.dataset.minutes) - Number(b.dataset.minutes)
          : sort.value === "title"
            ? a.dataset.title!.localeCompare(b.dataset.title!)
            : items.indexOf(a) - items.indexOf(b),
    );
    document.querySelector("#articles-grid")!.append(...ordered);
    const params = new URLSearchParams();
    if (input.value.trim()) params.set("q", input.value.trim());
    if (topic) params.set("topic", topic);
    if (budget.value !== "0") params.set("minutes", budget.value);
    if (sort.value !== "newest") params.set("sort", sort.value);
    history.replaceState(
      null,
      "",
      location.pathname + (params.size ? "?" + params : ""),
    );
    buttons.forEach((button) =>
      button.setAttribute(
        "aria-pressed",
        String(button.dataset.topic === topic),
      ),
    );
  };
  budget.addEventListener("change", filter);
  sort.addEventListener("change", filter);
  window.addEventListener("popstate", () => {
    restore();
    filter();
  });
  filter();
  input.addEventListener("input", filter);
  buttons.forEach((button) =>
    button.addEventListener("click", () => {
      topic = button.dataset.topic!;
      filter();
    }),
  );
  document.getElementById("clear-filters")?.addEventListener("click", () => {
    topic = "";
    budget.value = "0";
    sort.value = "newest";
    input.value = "";
    filter();
    input.focus();
  });
</script>
